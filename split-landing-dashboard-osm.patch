+        color: #fff;
+        font-size: 1rem;
+        display: flex;
+        align-items: center;
+        justify-content: center;
+        cursor: pointer;
+        backdrop-filter: blur(4px);
+        transition: background .18s ease, transform .18s ease;
+        z-index: 10;
+    }
+    .btn-mute:hover {
+        background: rgba(0, 0, 0, .82);
+        transform: scale(1.12);
+    }
+    .btn-mute:focus-visible {
+        outline: 2px solid #fff;
+        outline-offset: 2px;
+    }
+</style>
+
+@section Scripts {
+<script>
+    // Datos de los episodios
+    const episodios = [
+        { src: '/videos/podcast-ep1.mp4', ep: 'Ep. 01', titulo: 'Historia de nuestra escuela', desc: 'Un recorrido por los 50 años de trayectoria educativa.' },
+        { src: '/videos/podcast-ep2.mp4', ep: 'Ep. 02', titulo: 'Voces del aula', desc: 'Docentes y alumnos comparten su experiencia diaria.' },
+        { src: '/videos/podcast-ep3.mp4', ep: 'Ep. 03', titulo: 'El futuro empieza aquí', desc: 'Proyectos y actividades que transforman la comunidad.' }
+    ];
+    let epActual = 0;
+
+    // Función para rotar la tarjeta central
+    function siguienteEpisodio() {
+        epActual = (epActual + 1) % episodios.length; // Cicla del 0 al 2 y vuelve a empezar
+        const data = episodios[epActual];
+
+        const video = document.getElementById('videoDestacado');
+        video.src = data.src;
+        video.load(); // fuerza a recargar el recurso; sin esto el frame queda congelado en el video anterior
+        video.play();
+
+        document.getElementById('badgeEpisodio').innerText = data.ep;
+        document.getElementById('tituloEpisodio').innerText = data.titulo;
+        document.getElementById('descEpisodio').innerText = data.desc;
+    }
+
+    // Función para abrir el video en grande con controles
+    function abrirModalVideo() {
+        const modalVideo = document.getElementById('videoModal');
+        modalVideo.src = episodios[epActual].src;
+        modalVideo.play();
+    }
+
+    // Pausar el video automáticamente si el usuario cierra el Modal
+    document.getElementById('podcastModal').addEventListener('hidden.bs.modal', function () {
+        document.getElementById('videoModal').pause();
+    });
+
+    // Mute / unmute del video destacado, sin abrir el modal al tocar el botón
+    function toggleMuteDestacado(event) {
+        event.stopPropagation(); // evita que el click dispare la apertura del modal
+        const video = document.getElementById('videoDestacado');
+        const icono = document.querySelector('#btnMuteDestacado i');
+        video.muted = !video.muted;
+        icono.className = video.muted ? 'bi bi-volume-mute-fill' : 'bi bi-volume-up-fill';
+    }
+</script>
+}
