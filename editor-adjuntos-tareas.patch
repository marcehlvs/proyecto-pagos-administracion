+    <script>
+        $(function () {
+            // Los editores viven adentro de <details>, colapsados. Summernote necesita medidas
+            // reales para calcular su toolbar, así que se inicializa recién al abrirse (si se
+            // inicializara de entrada, adentro de un <details> cerrado, queda mal renderizado).
+            document.querySelectorAll('details').forEach(function (det) {
+                det.addEventListener('toggle', function () {
+                    if (!det.open) return;
+                    var textarea = det.querySelector('textarea[id^="editor-entrega-"]');
+                    if (textarea && !$(textarea).next('.note-editor').length) {
+                        initEditorTareas('#' + textarea.id);
+                    }
+                    var dropzone = det.querySelector('[id^="dropzone-entrega-"]');
+                    if (dropzone && !dropzone.dataset.inicializado) {
+                        dropzone.dataset.inicializado = '1';
+                        var input = det.querySelector('[id^="input-archivo-entrega-"]');
+                        initDropzoneArchivo('#' + dropzone.id, '#' + input.id);
+                    }
+                }, { once: false });
+            });
+        });
+    </script>
+}
