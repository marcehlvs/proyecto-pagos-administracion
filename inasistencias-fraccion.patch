+        // días con Educación Física (1/2 + 1/2) en vez de contar días enteros. Ver
+        // AsistenciaCalculadora.FormatearComoFraccion para cómo se imprime en el PDF.
+        public decimal Inasistencias { get; set; }
     }
 
