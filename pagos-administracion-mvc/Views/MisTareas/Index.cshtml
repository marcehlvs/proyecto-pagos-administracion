@model List<pagos_administracion_mvc.Models.Entrega>
@{
    var misAlumnos = (List<pagos_administracion_mvc.Models.Alumno>)ViewBag.MisAlumnos;
    var alumno = (pagos_administracion_mvc.Models.Alumno)ViewBag.AlumnoSeleccionado;
    ViewData["Title"] = "Tareas";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-bs5.min.css">
<link rel="stylesheet" href="~/css/editor-tareas.css" asp-append-version="true">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tareas</h1>

    @if (misAlumnos.Count > 1)
    {
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small text-muted">Alumno</label>
            <select name="alumnoId" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var a in misAlumnos)
                {
                    <option value="@a.Id" selected="@(a.Id == alumno.Id)">@a.Apellido, @a.Nombre</option>
                }
            </select>
        </form>
    }
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["ErrorTarea"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorTarea"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay tareas cargadas.</p>
}

@foreach (var entrega in Model)
{
    var tarea = entrega.Tarea;
    var vencida = !entrega.Entregada && tarea.FechaEntrega < DateTime.Today;
    var editorId = $"editor-entrega-{entrega.Id}";
    var dropzoneId = $"dropzone-entrega-{entrega.Id}";
    var inputId = $"input-archivo-entrega-{entrega.Id}";

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="card-title mb-1">@tarea.Titulo</h5>
                    <p class="text-muted small mb-1">@tarea.CursoAsignatura.Asignatura.Nombre — entrega: @tarea.FechaEntrega.ToString("dd/MM/yyyy")</p>
                </div>
                <span class="badge @(entrega.Entregada ? "bg-success" : vencida ? "bg-danger" : "bg-secondary")">
                    @(entrega.Entregada ? "Entregada" : vencida ? "Vencida" : "Pendiente")
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(tarea.Descripcion))
            {
                <div class="card-text">@Html.Raw(tarea.Descripcion)</div>
            }
            @if (tarea.ArchivoRuta != null)
            {
                <p class="mb-2">
                    <a asp-action="DescargarArchivoTarea" asp-route-tareaId="@tarea.Id" target="_blank">
                        📎 @(tarea.ArchivoNombreOriginal ?? "adjunto de la consigna")
                    </a>
                </p>
            }

            @if (entrega.Calificacion.HasValue)
            {
                <p class="mb-1"><strong>Calificación:</strong> @entrega.Calificacion.Value.ToString("0.##")</p>
            }
            @if (!string.IsNullOrWhiteSpace(entrega.ObservacionDocente))
            {
                <p class="mb-2 small"><strong>Comentario del Docente:</strong> @entrega.ObservacionDocente</p>
            }

            @if (entrega.ArchivoRuta != null)
            {
                <p class="mb-2">
                    <a asp-action="DescargarArchivo" asp-route-entregaId="@entrega.Id" target="_blank">
                        📎 @(entrega.ArchivoNombreOriginal ?? "archivo entregado")
                    </a>
                </p>
            }

            <details class="mt-2">
                <summary class="small text-primary" style="cursor:pointer;">
                    @(entrega.Entregada ? "Volver a entregar / editar" : "Entregar")
                </summary>
                <form asp-controller="MisTareas" asp-action="Subir" method="post" enctype="multipart/form-data" class="mt-2">
                    <input type="hidden" name="entregaId" value="@entrega.Id" />
                    <div class="mb-2">
                        <textarea name="texto" id="@editorId" class="form-control" rows="3" placeholder="Escribí tu respuesta (opcional si adjuntás archivo)">@Html.Raw(entrega.Texto)</textarea>
                    </div>
                    <div class="mb-2">
                        <div class="dropzone-archivo" id="@dropzoneId">
                            <input type="file" name="archivo" id="@inputId" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx" />
                            <span class="dropzone-icono">⬆</span>
                            <div>Arrastre y suelte aquí su archivo, o <a href="#" data-buscar>búsquelo</a></div>
                            <small data-nombre-archivo>Permitido: jpg, png, pdf, doc o docx — máx 5MB.</small>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Entregar</button>
                </form>
            </details>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-bs5.min.js"></script>
    <script src="~/js/editor-tareas.js" asp-append-version="true"></script>
    <script>
        $(function () {
            // Los editores viven adentro de <details>, colapsados. Summernote necesita medidas
            // reales para calcular su toolbar, así que se inicializa recién al abrirse (si se
            // inicializara de entrada, adentro de un <details> cerrado, queda mal renderizado).
            document.querySelectorAll('details').forEach(function (det) {
                det.addEventListener('toggle', function () {
                    if (!det.open) return;
                    var textarea = det.querySelector('textarea[id^="editor-entrega-"]');
                    if (textarea && !$(textarea).next('.note-editor').length) {
                        initEditorTareas('#' + textarea.id);
                    }
                    var dropzone = det.querySelector('[id^="dropzone-entrega-"]');
                    if (dropzone && !dropzone.dataset.inicializado) {
                        dropzone.dataset.inicializado = '1';
                        var input = det.querySelector('[id^="input-archivo-entrega-"]');
                        initDropzoneArchivo('#' + dropzone.id, '#' + input.id);
                    }
                }, { once: false });
            });
        });
    </script>
}
