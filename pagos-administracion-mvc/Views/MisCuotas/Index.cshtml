@model IEnumerable<pagos_administracion_mvc.Models.Cuota>
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Mis Cuotas";
    var anios = Model.Select(c => c.Anio).Distinct().OrderByDescending(a => a);
}

<h1>Mis Cuotas</h1>

@foreach (var anio in anios)
{
    <h4 class="mt-4">@anio</h4>
    <table class="table table-striped">
        <thead>
            <tr><th>Alumno</th><th>Mes</th><th>Monto</th><th>Vencimiento</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var cuota in Model.Where(c => c.Anio == anio).OrderBy(c => c.Mes))
            {
                <tr>
                    <td>@cuota.Alumno.Apellido, @cuota.Alumno.Nombre</td>
                    <td>@cuota.Mes</td>
                    <td>@cuota.Monto.ToString("C")</td>
                    <td>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                    <td>
                        @{
                            var badgeClass = cuota.Estado switch
                            {
                                EstadoCuota.Pagada => "bg-success",
                                EstadoCuota.Vencida => "bg-danger",
                                EstadoCuota.Parcial => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@cuota.Estado</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@cuota.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        @if (cuota.Estado == EstadoCuota.Pendiente || cuota.Estado == EstadoCuota.Vencida)
                        {
                            <a asp-controller="Pagos" asp-action="Pagar" asp-route-cuotaId="@cuota.Id" class="btn btn-sm btn-success">Pagar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}