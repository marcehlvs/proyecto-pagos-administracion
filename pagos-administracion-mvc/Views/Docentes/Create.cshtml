@{
    ViewData["Title"] = "Nuevo docente";
}

<h1>Nuevo docente</h1>

<div class="card p-4 mb-3" style="max-width: 500px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label class="control-label">Email del docente</label>
            <input type="email" name="email" class="form-control" required />
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Crear acceso</button>
        </div>
    </form>
</div>

<div>
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>
