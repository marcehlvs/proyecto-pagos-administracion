@model pagos_administracion_mvc.Data.ApplicationUser

@{
    ViewData["Title"] = "Eliminar docente";
    var materias = (List<pagos_administracion_mvc.Models.CursoAsignatura>)ViewBag.MateriasAsignadas;
}

<h1>Eliminar docente</h1>

@if (materias.Any())
{
    <div class="alert alert-warning">
        <strong>⚠ Tiene @materias.Count materia(s) asignada(s): @string.Join(", ", materias.Select(m => $"{m.Curso.Etiqueta} — {m.Asignatura.Nombre}")).</strong>
        <p class="mb-0">Si eliminás este docente, esas materias quedan sin docente asignado (no se borran ni se pierde el historial de notas).</p>
    </div>
}

<div class="card p-4 mb-3" style="max-width: 500px;">
    <p class="mb-0"><strong>Email:</strong> @Model.Email</p>
</div>

<form asp-action="Delete">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
