@model pagos_administracion_mvc.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var nombreMes = System.Globalization.CultureInfo.GetCultureInfo("es-AR").DateTimeFormat.GetMonthName(Model.MesActual);
}

<h1 class="mb-1">Dashboard</h1>
<p class="text-muted mb-4">Resumen de @nombreMes de @Model.AnioActual</p>

@{
    var alertas = new (int Cantidad, string Texto, string Controller, string Action, object? Ruta)[]
    {
        (Model.CuotasPorVencer, "cuota(s) vencen en los próximos 7 días", "Cuotas", "Index", null),
        (Model.TareasSinCalificar, "entrega(s) de tareas esperando calificación", "Tareas", "Index", null),
        (Model.CursosSinAsistenciaReciente, "curso(s) sin asistencia cargada en los últimos 3 días", "Asistencias", "Resumen", null),
        (Model.BoletinesPendientes, "boletín(es) de curso sin publicar", "Boletines", "Publicaciones", null),
    };
    var hayAlertas = alertas.Any(a => a.Cantidad > 0);
}
@if (hayAlertas)
{
    <div class="card p-3 mb-4 border-warning">
        <h6 class="mb-3">⚠️ Para revisar</h6>
        <ul class="list-unstyled mb-0">
            @foreach (var alerta in alertas.Where(a => a.Cantidad > 0))
            {
                <li class="mb-1">
                    <a asp-controller="@alerta.Controller" asp-action="@alerta.Action">
                        <span class="badge bg-warning text-dark">@alerta.Cantidad</span>
                        @alerta.Texto
                    </a>
                </li>
            }
        </ul>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 p-3">
            <span class="text-muted small">Recaudación del mes</span>
            <span class="fs-3 fw-bold text-success">@Model.RecaudacionMes.ToString("C")</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-3">
            <span class="text-muted small">Morosidad (histórico)</span>
            <span class="fs-3 fw-bold text-warning">@Model.PorcentajeMorosidad.ToString("0.0")%</span>
            <span class="text-muted small">@Model.TotalVencidasHistorico de @Model.TotalCuotasHistorico cuotas vencidas</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-3">
            <span class="text-muted small">Cuotas del mes</span>
            <span class="fs-3 fw-bold">@Model.TotalCuotasMes</span>
            <span class="text-muted small">@Model.CuotasPagadas pagadas / @(Model.TotalCuotasMes - Model.CuotasPagadas) restantes</span>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card p-3">
            <h6 class="mb-3">Cuotas pagadas vs. pendientes (mes actual)</h6>
            <canvas id="graficoCuotasEstado" height="220"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <h6 class="mb-3">Distribución de morosidad (histórico)</h6>
            <canvas id="graficoMorosidad" height="220"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const colorPagadas = '#10B981';
        const colorPendientes = '#F59E0B';
        const colorVencidas = '#DC2626';
        const colorParciales = '#3B82F6';

        new Chart(document.getElementById('graficoCuotasEstado'), {
            type: 'bar',
            data: {
                labels: ['Pagadas', 'Pendientes', 'Vencidas', 'Parciales'],
                datasets: [{
                    label: 'Cuotas',
                    data: [@Model.CuotasPagadas, @Model.CuotasPendientes, @Model.CuotasVencidas, @Model.CuotasParciales],
                    backgroundColor: [colorPagadas, colorPendientes, colorVencidas, colorParciales]
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        new Chart(document.getElementById('graficoMorosidad'), {
            type: 'pie',
            data: {
                labels: ['Vencidas', 'Al día'],
                datasets: [{
                    data: [@Model.TotalVencidasHistorico, @(Model.TotalCuotasHistorico - Model.TotalVencidasHistorico)],
                    backgroundColor: [colorVencidas, colorPagadas]
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}
