@* Botón flotante + modal del asistente de IA. Se incluye una sola vez desde _Layout.cshtml,
   condicionado por rol (Familia o Alumno) — el propio Controller ya limita qué tools ve
   cada uno, este partial solo decide si mostrar o no el botón. *@

<button type="button" class="asistente-flotante" data-bs-toggle="modal" data-bs-target="#modalAsistente" title="Preguntale al asistente">
    <i class="bi bi-chat-dots-fill"></i>
</button>

<div class="modal fade" id="modalAsistente" tabindex="-1" aria-labelledby="modalAsistenteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAsistenteLabel">
                    <i class="bi bi-robot me-2"></i>Asistente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div id="asistenteHistorial" class="asistente-historial">
                    <!-- El texto debe ir en una sola línea sin espacios en blanco antes ni después -->
                    <div class="asistente-mensaje asistente-mensaje-bot">¡Hola! ¿En qué te puedo ayudar?</div>
                </div>
                <div id="asistenteCargando" class="text-center text-muted small mt-2 mb-3 d-none">
                    <span class="spinner-border spinner-border-sm me-1"></span> Pensando...
                </div>
            </div>
            <div class="modal-footer border-0 bg-transparent pt-0">
                <form id="asistenteForm" class="d-flex w-100 chat-input-container">
                    <input type="text" id="asistenteInput" class="form-control chat-input" placeholder="Escribí tu consulta..." autocomplete="off" required />
                    <button type="submit" class="btn btn-primary btn-chat-send">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos generales del Modal para que parezca una app moderna */
    #modalAsistente .modal-content {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    }

    #modalAsistente .modal-header {
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 1rem 1.25rem;
    }

    /* Botón flotante con leve gradiente y animación */
    .asistente-flotante {
        position: fixed;
        bottom: 90px;
        right: 20px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--bs-primary), #0a58ca);
        color: #fff;
        border: none;
        font-size: 1.5rem;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.35);
        z-index: 1040;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .asistente-flotante:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.45);
        }

    /* Historial con scrollbar afinada */
    .asistente-historial {
        max-height: 55vh;
        overflow-y: auto;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

        .asistente-historial::-webkit-scrollbar {
            width: 6px;
        }

        .asistente-historial::-webkit-scrollbar-track {
            background: transparent;
        }

        .asistente-historial::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.15);
            border-radius: 10px;
        }

    /* Burbujas de chat modernas */
    .asistente-mensaje {
        padding: 0.65rem 1rem;
        border-radius: 1.25rem;
        max-width: 85%;
        white-space: pre-wrap;
        line-height: 1.4;
        font-size: 0.95rem;
        box-shadow: 0 2px 5px rgba(0,0,0,0.04);
        animation: asistente-aparecer 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @@keyframes asistente-aparecer {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .asistente-mensaje-bot {
        background-color: #f8f9fa;
        color: #212529;
        margin-right: auto;
        border-bottom-left-radius: 0.3rem;
        border: 1px solid #e9ecef;
    }

    .asistente-mensaje-usuario {
        background: linear-gradient(135deg, var(--bs-primary), #0a58ca);
        color: #fff;
        margin-left: auto;
        border-bottom-right-radius: 0.3rem;
    }

    /* Contenedor del Input tipo pastilla */
    .chat-input-container {
        background-color: #f8f9fa;
        border-radius: 2rem;
        padding: 0.35rem;
        border: 1px solid #dee2e6;
        align-items: center;
    }

    .chat-input {
        border: none;
        background: transparent;
        box-shadow: none !important;
        padding-left: 1rem;
    }

    .btn-chat-send {
        border-radius: 50%;
        width: 38px;
        height: 38px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>

<script>
    document.getElementById('asistenteForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const input = document.getElementById('asistenteInput');
        const historial = document.getElementById('asistenteHistorial');
        const cargando = document.getElementById('asistenteCargando');
        const mensaje = input.value.trim();
        if (!mensaje) return;

        // Escapa texto antes de insertarlo como HTML, sin depender de jQuery.
        function escapeHtml(texto) {
            const div = document.createElement('div');
            div.textContent = texto;
            return div.innerHTML;
        }

        historial.insertAdjacentHTML('beforeend',
            `<div class="asistente-mensaje asistente-mensaje-usuario">${escapeHtml(mensaje)}</div>`);
        input.value = '';
        input.disabled = true;
        cargando.classList.remove('d-none');
        historial.scrollTop = historial.scrollHeight;

        try {
            const resp = await fetch('@Url.Action("Consultar", "Asistente")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mensaje: mensaje })
            });

            if (!resp.ok) throw new Error('Error de red');

            const data = await resp.json();
            historial.insertAdjacentHTML('beforeend',
                `<div class="asistente-mensaje asistente-mensaje-bot">${escapeHtml(data.respuesta)}</div>`);
        } catch (err) {
            historial.insertAdjacentHTML('beforeend',
                `<div class="asistente-mensaje asistente-mensaje-bot">Uy, tuve un problema para responder. Probá de nuevo en un momento.</div>`);
        } finally {
            cargando.classList.add('d-none');
            input.disabled = false;
            input.focus();
            historial.scrollTop = historial.scrollHeight;
        }
    });
</script>
