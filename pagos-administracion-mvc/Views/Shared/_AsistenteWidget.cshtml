@* Botón flotante + modal del asistente de IA. Se incluye una sola vez desde _Layout.cshtml,
   condicionado por rol (Familia o Alumno) — el propio Controller ya limita qué tools ve
   cada uno, este partial solo decide si mostrar o no el botón. *@

<button type="button" class="asistente-flotante" data-bs-toggle="modal" data-bs-target="#modalAsistente" title="Preguntale al asistente">
    <i class="bi bi-chat-dots-fill"></i>
</button>

<button type="button" class="asistente-flotante" data-bs-toggle="modal" data-bs-target="#modalAsistente" title="Preguntale al asistente">
    <i class="bi bi-chat-dots-fill"></i>
</button>

<!-- Agregamos modal-dialog-centered -->
<div class="modal fade" id="modalAsistente" tabindex="-1" aria-labelledby="modalAsistenteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">

        <!-- Forzamos fondo blanco y texto oscuro para que no herede el tema dark de la web -->
        <div class="modal-content bg-white text-dark">

            <!-- Cabecera con fondo sutil y título en negrita -->
            <div class="modal-header bg-light border-bottom-0 py-3">
                <h5 class="modal-title fw-bold fs-6" id="modalAsistenteLabel">
                    <i class="bi bi-robot text-primary me-2"></i>Asistente Escolar
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-0">
                <div id="asistenteHistorial" class="asistente-historial">
                    <div class="asistente-mensaje asistente-mensaje-bot">¡Hola! ¿En qué te puedo ayudar hoy?</div>
                </div>
                <div id="asistenteCargando" class="text-center text-primary fw-bold small mt-2 mb-3 d-none">
                    <span class="spinner-border spinner-border-sm me-1"></span> Pensando...
                </div>
            </div>

            <div class="modal-footer border-0 bg-transparent pt-0 pb-3">
                <form id="asistenteForm" class="d-flex w-100 chat-input-container">
                    <input type="text" id="asistenteInput" class="form-control chat-input" placeholder="Escribí tu consulta..." autocomplete="off" required />
                    <button type="submit" class="btn btn-primary btn-chat-send">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<style>
    #modalAsistente .modal-content {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    }

    #modalAsistente .btn-close {
        filter: invert(0) !important;
        opacity: 0.5;
    }

        #modalAsistente .btn-close:hover {
            opacity: 1;
        }

    .asistente-flotante {
        position: fixed;
        bottom: 90px;
        right: 20px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--bs-primary), #0a58ca);
        color: #fff;
        border: none;
        font-size: 1.5rem;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.35);
        z-index: 1040;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .asistente-flotante:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.45);
        }

    .asistente-historial {
        max-height: 50vh;
        overflow-y: auto;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

        .asistente-historial::-webkit-scrollbar {
            width: 6px;
        }

        .asistente-historial::-webkit-scrollbar-track {
            background: transparent;
        }

        .asistente-historial::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.15);
            border-radius: 10px;
        }

    .asistente-mensaje {
        padding: 0.7rem 1.1rem;
        border-radius: 1.25rem;
        max-width: 85%;
        white-space: pre-wrap;
        line-height: 1.4;
        font-size: 0.95rem;
        animation: asistente-aparecer 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @@keyframes asistente-aparecer {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .asistente-mensaje-bot {
        background-color: #f1f3f5; /* Gris súper clarito para la burbuja del bot */
        color: #212529; /* Texto oscuro */
        margin-right: auto;
        border-bottom-left-radius: 0.25rem;
    }

    .asistente-mensaje-usuario {
        background: linear-gradient(135deg, var(--bs-primary), #0a58ca);
        color: #ffffff;
        margin-left: auto;
        border-bottom-right-radius: 0.25rem;
        box-shadow: 0 2px 8px rgba(13, 110, 253, 0.25);
    }

    .chat-input-container {
        background-color: #f8f9fa; /* Fondo gris claro para el contenedor */
        border-radius: 2rem;
        padding: 0.4rem;
        border: 1px solid #dee2e6;
        align-items: center;
    }

    .chat-input {
        border: none;
        background-color: transparent !important; /* Hacemos que el input sea transparente */
        color: #212529 !important; /* Forzamos texto oscuro al escribir */
        box-shadow: none !important;
        padding-left: 1rem;
    }

        .chat-input::placeholder {
            color: #adb5bd !important;
        }

    .btn-chat-send {
        border-radius: 50%;
        width: 40px;
        height: 40px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>

<script>
    // Limpiamos el historial en el servidor al abrir el modal para empezar de cero
    const modalAsistente = document.getElementById('modalAsistente');
    if (modalAsistente) {
        modalAsistente.addEventListener('show.bs.modal', function() {
            fetch('@Url.Action("Reiniciar", "Asistente")', { method: 'POST' });
            document.getElementById('asistenteHistorial').innerHTML =
                '<div class="asistente-mensaje asistente-mensaje-bot">¡Hola! ¿En qué te puedo ayudar hoy?</div>';
        });
    }

    document.getElementById('asistenteForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const input = document.getElementById('asistenteInput');
        const historial = document.getElementById('asistenteHistorial');
        const cargando = document.getElementById('asistenteCargando');
        const mensaje = input.value.trim();
        if (!mensaje) return;

        function escapeHtml(texto) {
            const div = document.createElement('div');
            div.textContent = texto;
            return div.innerHTML;
        }

        function linkificar(textoEscapado) {
            const regexUrl = /(https?:\/\/[^\s<]+)|(\/[A-Z][A-Za-z]*\/[A-Za-z]+(?:\?[^\s<]*)?)/g;
            return textoEscapado.replace(regexUrl, (match) => {
                const limpio = match.replace(/[.,;:)]+$/, '');
                const sobra = match.slice(limpio.length);
                return `<a href="${limpio}" target="_blank" class="text-decoration-underline fw-bold">${limpio}</a>${sobra}`;
            });
        }

        historial.insertAdjacentHTML('beforeend',
            `<div class="asistente-mensaje asistente-mensaje-usuario">${escapeHtml(mensaje)}</div>`);

        input.value = '';
        input.disabled = true;
        cargando.classList.remove('d-none');
        historial.scrollTop = historial.scrollHeight;

        try {
            const resp = await fetch('@Url.Action("Consultar", "Asistente")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mensaje: mensaje })
            });

            if (!resp.ok) throw new Error('Error de red');

            const data = await resp.json();

            historial.insertAdjacentHTML('beforeend',
                `<div class="asistente-mensaje asistente-mensaje-bot">${linkificar(escapeHtml(data.respuesta))}</div>`);

            if (data.redireccion) {
                historial.insertAdjacentHTML('beforeend',
                    `<div class="asistente-mensaje asistente-mensaje-bot text-muted small mt-2">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Redirigiendo a Mercado Pago...
                         </div>`);
                historial.scrollTop = historial.scrollHeight;
                setTimeout(() => { window.location.href = data.redireccion; }, 1200);
            }

        } catch (err) {
            historial.insertAdjacentHTML('beforeend',
                `<div class="asistente-mensaje asistente-mensaje-bot text-danger">Uy, tuve un problema de conexión. Probá de nuevo.</div>`);
        } finally {
            cargando.classList.add('d-none');
            input.disabled = false;
            input.focus();
            historial.scrollTop = historial.scrollHeight;
        }
    });
</script>

    