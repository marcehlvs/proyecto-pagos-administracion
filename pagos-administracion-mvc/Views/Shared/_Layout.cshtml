@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Escuela José de San Martín</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script type="importmap"></script>
    <script>
            (function() {
                var tema = localStorage.getItem('tema') || 'light';
                document.documentElement.setAttribute('data-bs-theme', tema);
            })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/pagos_administracion_mvc.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary-institucional mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Escuela José de San Martín</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
                        Func<string, string> clase = c => "nav-link" + (string.Equals(controladorActual, c, StringComparison.OrdinalIgnoreCase) ? " active" : "");
                        var enGestion = new[] { "Alumnos", "Familias", "Cuotas", "GenerarCuotas" }
                            .Contains(controladorActual, StringComparer.OrdinalIgnoreCase);
                    }
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@clase("Home")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="@clase("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item">
                                <a class="@clase("Pagos")" asp-controller="Pagos" asp-action="Index">
                                    Pagos
                                    <vc:pagos-pendientes-badge></vc:pagos-pendientes-badge>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(enGestion ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Gestión
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Alumnos" asp-action="Index"><i class="bi bi-people"></i> Alumnos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Familias" asp-action="Index"><i class="bi bi-house-heart"></i> Familias</a></li>
                                    <li><a class="dropdown-item" asp-controller="Cuotas" asp-action="Index"><i class="bi bi-receipt"></i> Cuotas</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="GenerarCuotas" asp-action="Index"><i class="bi bi-magic"></i> Generar cuotas</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Familia"))
                        {
                            <li class="nav-item"><a class="@clase("MisCuotas")" asp-controller="MisCuotas" asp-action="Index">Mis Cuotas</a></li>
                        }
                    </ul>

                    <!-- Componente de Login/Perfil -->
                    <partial name="_LoginPartial" />

                    <!-- Switch de Tema -->
                    <div class="form-check form-switch text-white d-flex align-items-center ms-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="temaSwitch">
                        <label class="form-check-label ms-1" for="temaSwitch">🌙</label>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="mt-5 py-4" style="background-color: var(--color-primary-dark);">
        <div class="container text-white">
            <div class="row g-4 align-items-center">

                <!-- Columna Izquierda: Info de contacto (4 de 12) -->
                <div class="col-md-4">
                    <h6 class="fw-bold">Escuela José de San Martín</h6>
                    <p class="small mb-1">📍 @Configuration["DatosEscuela:Direccion"]</p>
                    <p class="small mb-1">📞 @Configuration["DatosEscuela:Telefono"]</p>
                    <p class="small mb-1">🕒 @Configuration["DatosEscuela:Horario"]</p>
                    <div class="mt-3">
                        <a href="@(Configuration["DatosEscuela:Facebook"])" target="_blank" class="text-white text-decoration-none me-3">
                            <i class="bi bi-facebook fs-5"></i>
                        </a>
                        <a href="@(Configuration["DatosEscuela:Instagram"])" target="_blank" class="text-white text-decoration-none me-3">
                            <i class="bi bi-instagram fs-5"></i>
                        </a>
                        <a href="mailto:@(Configuration["DatosEscuela:Email"])" class="text-white text-decoration-none">
                            <i class="bi bi-envelope fs-5"></i>
                        </a>
                    </div>
                </div>

                <!-- Columna Derecha: Mapa (8 de 12) -->
                <div class="col-md-8">
                    <iframe src="https://www.google.com/maps?q=@(Uri.EscapeDataString(Configuration["DatosEscuela:Direccion"] ?? ""))&output=embed"
                            class="w-100 shadow-sm" height="180" style="border:0; border-radius: 8px;" loading="lazy">
                    </iframe>
                </div>

            </div>
            <hr class="border-light opacity-25 my-4" />
            <div class="text-center small">
                &copy; 2026 - Escuela José de San Martín - <a asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none">Privacy</a>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <a href="https://wa.me/5491126758365?text=Hola,%20me%20comunico%20desde%20el%20portal%20de%20la%20escuela"
       target="_blank" class="whatsapp-flotante" title="Contactar por WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>
</body>
</html>
