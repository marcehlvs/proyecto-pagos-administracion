@model pagos_administracion_mvc.Models.PreguntaViewModel
@{
    int idx = (int)(ViewData["index"] ?? 0);
    var letras = new[] { "A", "B", "C", "D" };
}

<div class="card border-0 shadow-sm mb-3 pregunta-card" data-index="@idx">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold text-primary">
            <i class="bi bi-question-circle me-2"></i>Pregunta <span class="num-pregunta">@(idx + 1)</span>
        </span>
        <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-pregunta">
            <i class="bi bi-trash"></i>
        </button>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fw-medium">Enunciado <span class="text-danger">*</span></label>
                <textarea name="Preguntas[@idx].Enunciado" class="form-control" rows="2"
                          placeholder="Escribi la pregunta aqui..." required>@Model.Enunciado</textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-medium">Puntaje</label>
                <div class="input-group">
                    <input type="number" name="Preguntas[@idx].Puntaje" value="@Model.Puntaje"
                           min="1" max="100" class="form-control" />
                    <span class="input-group-text">pt</span>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <label class="form-label fw-medium">
                Opciones <span class="text-danger">*</span>
                <small class="text-muted fw-normal ms-2">Selecciona el radio para marcar la correcta</small>
            </label>
            <div class="opciones-container row g-2">
                @for (int j = 0; j < Model.Opciones.Count && j < 4; j++)
                {
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 p-2 rounded border opcion-row @(Model.OpcionCorrectaIndex == j ? "border-success bg-success bg-opacity-10" : "")">
                            <input type="radio" name="Preguntas[@idx].OpcionCorrectaIndex"
                                   value="@j" class="form-check-input mt-0 flex-shrink-0"
                                   @(Model.OpcionCorrectaIndex == j ? "checked" : "") />
                            <span class="badge @(Model.OpcionCorrectaIndex == j ? "bg-success" : "bg-secondary")"
                                  style="min-width:24px">@letras[j]</span>
                            <input type="text" name="Preguntas[@idx].Opciones[@j].Texto"
                                   value="@Model.Opciones[j].Texto"
                                   class="form-control form-control-sm border-0 bg-transparent p-0"
                                   placeholder="Opcion @letras[j]@(j < 2 ? "" : " (opcional)")"
                                   @(j < 2 ? "required" : "") />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
