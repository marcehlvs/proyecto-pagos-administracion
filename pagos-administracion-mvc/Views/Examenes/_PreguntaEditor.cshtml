@model pagos_administracion_mvc.Models.PreguntaViewModel
@{
    int i = ViewData["index"] is int idx ? idx : 0;
    var letras = new[] { "A", "B", "C", "D" };
}

<div class="card border-0 shadow-sm mb-3 pregunta-card" data-index="@i">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold text-primary">
            <i class="bi bi-question-circle me-2"></i>Pregunta <span class="num-pregunta">@(i + 1)</span>
        </span>
        <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-pregunta">
            <i class="bi bi-trash"></i>
        </button>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label fw-medium">Enunciado <span class="text-danger">*</span></label>
            <textarea name="Preguntas[@i].Enunciado" class="form-control" rows="2"
                      placeholder="Escribí la pregunta aquí..." required>@Model.Enunciado</textarea>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label fw-medium">Puntaje</label>
                <input type="number" name="Preguntas[@i].Puntaje" value="@Model.Puntaje" min="1" max="100" class="form-control" />
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label fw-medium">Opciones <span class="text-danger">*</span></label>
            <p class="small text-muted mb-2">Marcá el botón de la izquierda para indicar la respuesta correcta.</p>
        </div>
        <div class="opciones-container">
            @for (int j = 0; j < 4; j++)
            {
                var texto = j < Model.Opciones.Count ? Model.Opciones[j].Texto : string.Empty;
                <div class="d-flex align-items-center gap-2 mb-2">
                    <input type="radio" name="Preguntas[@i].OpcionCorrectaIndex" value="@j"
                           class="form-check-input mt-0 flex-shrink-0"
                           @(Model.OpcionCorrectaIndex == j ? "checked" : "")
                           @(j == 0 ? "required" : "") />
                    <span class="badge @(Model.OpcionCorrectaIndex == j ? "bg-success" : "bg-secondary")"
                          style="min-width:24px">@letras[j]</span>
                    <input type="text" name="Preguntas[@i].Opciones[@j].Texto" value="@texto"
                           class="form-control form-control-sm"
                           placeholder="Opción @letras[j]@(j >= 2 ? " (opcional)" : "")"
                           @(j < 2 ? "required" : "") />
                </div>
            }
        </div>
    </div>
</div>
