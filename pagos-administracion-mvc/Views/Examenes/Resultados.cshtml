@model pagos_administracion_mvc.Models.Examen
@{
    ViewData["Title"] = $"Resultados – {Model.Titulo}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Exámenes</a></li>
        <li class="breadcrumb-item">
            <a asp-action="ListarPorMateria" asp-route-id="@Model.CursoAsignaturaId">
                @Model.CursoAsignatura.Asignatura.Nombre
            </a>
        </li>
        <li class="breadcrumb-item active">Resultados</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-bar-chart me-2 text-primary"></i>@Model.Titulo
        <small class="text-muted fs-6 ms-2">Resultados</small>
    </h1>
</div>

@{
    var intentosCompletos = Model.Intentos.Where(i => i.FechaFin != null).ToList();
    var aprobados = intentosCompletos.Count(i => i.Aprobado == true);
}

<!-- Resumen estadístico -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="display-6 fw-bold text-primary">@intentosCompletos.Count</div>
            <div class="small text-muted">Intentos completados</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="display-6 fw-bold text-success">@aprobados</div>
            <div class="small text-muted">Aprobados</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="display-6 fw-bold text-danger">@(intentosCompletos.Count - aprobados)</div>
            <div class="small text-muted">Desaprobados</div>
        </div>
    </div>
</div>

@if (!intentosCompletos.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="mt-3 text-muted">Todavía no hay intentos completados.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Alumno</th>
                        <th class="text-center">Nota</th>
                        <th class="text-center">Puntaje</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Duración</th>
                        <th class="text-center">Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var intento in intentosCompletos.OrderByDescending(i => i.FechaFin))
                    {
                        var alumno = intento.Inscripcion?.Alumno;
                        var duracion = intento.FechaFin - intento.FechaInicio;
                        <tr>
                            <td>
                                <span class="fw-medium">@alumno?.Apellido, @alumno?.Nombre</span>
                                <br><small class="text-muted">DNI: @alumno?.Dni</small>
                            </td>
                            <td class="text-center">
                                <span class="fw-bold fs-5">@intento.NotaValor?.ToString("F2")</span>
                            </td>
                            <td class="text-center text-muted small">
                                @intento.PuntajeObtenido / @intento.PuntajeTotal pts
                            </td>
                            <td class="text-center">
                                @if (intento.Aprobado == true)
                                {
                                    <span class="badge bg-success px-3">Aprobado</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3">Desaprobado</span>
                                }
                            </td>
                            <td class="text-center text-muted small">
                                @(duracion.HasValue ? $"{(int)duracion.Value.TotalMinutes}m {duracion.Value.Seconds}s" : "—")
                            </td>
                            <td class="text-center text-muted small">
                                @intento.FechaFin?.ToString("dd/MM HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
