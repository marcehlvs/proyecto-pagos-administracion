@model pagos_administracion_mvc.Models.GrillaAsistenciaViewModel
@using static pagos_administracion_mvc.Models.Enums
@{
    var curso = (pagos_administracion_mvc.Models.Curso)ViewBag.Curso;
    var mes = (int)ViewBag.Mes;
    var anio = (int)ViewBag.Anio;
    ViewData["Title"] = "Grilla — " + curso.Etiqueta;

    var nombresMes = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
    var nombresDia = new[] { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };

    var mesAnterior = mes == 1 ? 12 : mes - 1;
    var anioMesAnterior = mes == 1 ? anio - 1 : anio;
    var mesSiguiente = mes == 12 ? 1 : mes + 1;
    var anioMesSiguiente = mes == 12 ? anio + 1 : anio;

    var totalCeldas = Model.Filas.Count * Model.DiasHabiles.Count;
    var celdasSinCargar = Model.Filas.Sum(f => Model.DiasHabiles.Count(d => f.EstadosPorDia[d] == null));
}

<h1 class="mb-1">Grilla de asistencia — @curso.Etiqueta</h1>
<p class="text-muted mb-3">@curso.Nivel, @curso.GradoAnio° grado/año, turno @curso.Turno</p>

<div class="d-flex align-items-center gap-3 mb-3">
    <a asp-action="Grilla" asp-route-cursoId="@curso.Id" asp-route-mes="@mesAnterior" asp-route-anio="@anioMesAnterior"
       class="btn btn-outline-secondary btn-sm">← @nombresMes[mesAnterior]</a>
    <h5 class="mb-0">@nombresMes[mes] @anio</h5>
    <a asp-action="Grilla" asp-route-cursoId="@curso.Id" asp-route-mes="@mesSiguiente" asp-route-anio="@anioMesSiguiente"
       class="btn btn-outline-secondary btn-sm">@nombresMes[mesSiguiente] →</a>
</div>

@if (Model.Filas.Any() && Model.DiasHabiles.Any())
{
    if (celdasSinCargar > 0)
    {
        <div class="alert alert-warning py-2">
            ⚠️ @celdasSinCargar de @totalCeldas celda(s) todavía sin cargar en @nombresMes[mes].ToLower() @anio.
        </div>
    }
    else
    {
        <div class="alert alert-success py-2">
            ✅ Asistencia completa: no quedan celdas sin cargar este mes.
        </div>
    }
}

@if (!Model.Filas.Any())
{
    <p class="text-muted">Este curso todavía no tiene alumnos inscriptos.</p>
}
else if (!Model.DiasHabiles.Any())
{
    <p class="text-muted">@nombresMes[mes] @anio no tiene días hábiles (o caen todos en fin de semana / feriado).</p>
}
else
{
    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0 align-middle text-center">
                <thead>
                    <tr>
                        <th class="text-start" style="min-width: 170px;">Alumno</th>
                        @foreach (var dia in Model.DiasHabiles)
                        {
                            <th class="small fw-normal" style="min-width: 34px;">
                                <div class="text-muted" style="font-size: .7rem;">@nombresDia[(int)dia.DayOfWeek]</div>
                                <div>@dia.Day</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            <td class="text-start">@fila.AlumnoNombre</td>
                            @foreach (var dia in Model.DiasHabiles)
                            {
                                var estado = fila.EstadosPorDia[dia];
                                <td>
                                    @if (estado == null)
                                    {
                                        <span>&nbsp;</span>
                                    }
                                    else if (estado == EstadoAsistencia.Presente)
                                    {
                                        <span class="badge bg-success" title="Presente">P</span>
                                    }
                                    else if (estado == EstadoAsistencia.Ausente)
                                    {
                                        <span class="badge bg-danger" title="Ausente">A</span>
                                    }
                                    else if (estado == EstadoAsistencia.Tarde)
                                    {
                                        <span class="badge bg-warning text-dark" title="Tarde">T</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark" title="Justificada">J</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 small text-muted">
            <span class="badge bg-success">P</span> Presente
            <span class="badge bg-danger ms-2">A</span> Ausente
            <span class="badge bg-warning text-dark ms-2">T</span> Tarde
            <span class="badge bg-info text-dark ms-2">J</span> Justificada
            <span class="ms-3">Celda vacía = todavía sin cargar</span>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="ResumenCurso" asp-route-cursoId="@curso.Id" class="btn btn-link px-0">Volver a faltas del curso</a>
    <a asp-action="Tomar" asp-route-cursoId="@curso.Id" class="btn btn-link">Tomar asistencia de este curso</a>
</div>
