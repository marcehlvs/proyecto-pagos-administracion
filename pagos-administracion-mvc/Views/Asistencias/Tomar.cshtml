@model List<pagos_administracion_mvc.Models.Inscripcion>
@using static pagos_administracion_mvc.Models.Enums
@using pagos_administracion_mvc.Services
@{
    var curso = (pagos_administracion_mvc.Models.Curso)ViewBag.Curso;
    var fecha = (DateTime)ViewBag.Fecha;
    var diaTieneEF = (bool)ViewBag.DiaTieneEF;
    ViewData["Title"] = "Tomar asistencia";

    // En Educación Física, por ahora solo se registra Presente/Ausente (no Tarde, según lo definido).
    var estadosClase = new[] { EstadoAsistencia.Presente, EstadoAsistencia.Ausente, EstadoAsistencia.Tarde, EstadoAsistencia.Justificada };
    var estadosEF = new[] { EstadoAsistencia.Presente, EstadoAsistencia.Ausente };
}

<h1>Tomar asistencia</h1>
<p class="text-muted">
    @curso.Nombre — @curso.Nivel, @curso.GradoAnio° grado/año, turno @curso.Turno
    @if (diaTieneEF)
    {
        <span class="badge bg-info text-dark ms-2">Hoy hay Educación Física</span>
    }
</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="get" asp-action="Tomar" class="row g-2 mb-3 align-items-end">
    <input type="hidden" name="cursoId" value="@curso.Id" />
    <div class="col-auto">
        <label class="form-label small">Fecha</label>
        <input type="date" name="fecha" class="form-control" value="@fecha.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </div>
</form>

<form asp-action="Tomar" method="post">
    <input type="hidden" name="cursoId" value="@curso.Id" />
    <input type="hidden" name="fecha" value="@fecha.ToString("yyyy-MM-dd")" />

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th rowspan="2" class="align-middle">Alumno</th>
                <th colspan="@estadosClase.Length" class="text-center">Clase</th>
                @if (diaTieneEF)
                {
                    <th colspan="@estadosEF.Length" class="text-center">Educación Física</th>
                }
                <th rowspan="2" class="align-middle text-center">Falta del día</th>
            </tr>
            <tr>
                @foreach (var estado in estadosClase)
                {
                    <th class="text-center small fw-normal">@estado</th>
                }
                @if (diaTieneEF)
                {
                    foreach (var estado in estadosEF)
                    {
                        <th class="text-center small fw-normal">@estado</th>
                    }
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var inscripcion in Model)
            {
                var asistenciaClase = inscripcion.Asistencias.FirstOrDefault(a => a.Materia == Materia.Clase);
                var asistenciaEF = inscripcion.Asistencias.FirstOrDefault(a => a.Materia == Materia.EducacionFisica);
                var actualClase = asistenciaClase?.Estado ?? EstadoAsistencia.Presente;
                var actualEF = asistenciaEF?.Estado ?? EstadoAsistencia.Presente;

                var fraccionActual = AsistenciaCalculadora.CalcularFraccionFalta(Materia.Clase, actualClase, diaTieneEF)
                                    + (diaTieneEF ? AsistenciaCalculadora.CalcularFraccionFalta(Materia.EducacionFisica, actualEF, diaTieneEF) : 0m);

                <tr>
                    <td>@inscripcion.Alumno.Apellido, @inscripcion.Alumno.Nombre</td>
                    @foreach (var estado in estadosClase)
                    {
                        <td class="text-center">
                            <input type="radio" name="estadosClase[@inscripcion.Id]" value="@((int)estado)" checked="@(actualClase == estado)" />
                        </td>
                    }
                    @if (diaTieneEF)
                    {
                        foreach (var estado in estadosEF)
                        {
                            <td class="text-center">
                                <input type="radio" name="estadosEF[@inscripcion.Id]" value="@((int)estado)" checked="@(actualEF == estado)" />
                            </td>
                        }
                    }
                    <td class="text-center">
                        @if (fraccionActual > 0)
                        {
                            <span class="badge bg-warning text-dark">@fraccionActual.ToString("0.##")</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-muted">Este curso todavía no tiene alumnos inscriptos.</td></tr>
            }
        </tbody>
    </table>

    @if (Model.Any())
    {
        <button type="submit" class="btn btn-primary">Guardar asistencia</button>
    }
</form>

<div class="mt-3">
    <a asp-controller="Cursos" asp-action="Details" asp-route-id="@curso.Id" class="btn btn-link px-0">Volver al curso</a>
</div>
