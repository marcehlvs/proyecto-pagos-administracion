@model List<pagos_administracion_mvc.Models.FilaAlumnoFaltas>
@{
    var curso = (pagos_administracion_mvc.Models.Curso)ViewBag.Curso;
    ViewData["Title"] = "Faltas — " + curso.Etiqueta;
}

<h1 class="mb-1">Faltas — @curso.Etiqueta</h1>
<p class="text-muted mb-4">@Model.Count alumno(s) inscripto(s).</p>

@if (!Model.Any())
{
    <p class="text-muted">Este curso todavía no tiene alumnos inscriptos.</p>
}
else
{
    <div class="card p-3" style="max-width: 700px;">
        <table class="table table-striped table-sm mb-0">
            <thead>
                <tr>
                    <th>Alumno</th>
                    <th>Total faltas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Model)
                {
                    <tr>
                        <td class="align-middle">@fila.AlumnoNombre</td>
                        <td class="align-middle">
                            @if (fila.TotalFaltas > 0)
                            {
                                <span class="badge bg-warning text-dark">@fila.TotalFaltas.ToString("0.##")</span>
                            }
                            else
                            {
                                <span class="badge bg-success">0</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="Resumen" class="btn btn-link px-0">Volver al resumen</a>
    <a asp-action="Tomar" asp-route-cursoId="@curso.Id" class="btn btn-link">Tomar asistencia de este curso</a>
</div>
