@model pagos_administracion_mvc.Models.Cuota

@{
    ViewData["Title"] = "Eliminar cuota";
}

<h1>Eliminar cuota</h1>

<div class="alert alert-danger">
    ¿Confirmás que querés eliminar esta cuota? Esta acción no se puede deshacer.
</div>

<div class="card p-4 mb-3" style="max-width: 500px;">
    <dl class="row mb-0">
        <dt class="col-sm-5">Alumno</dt>
        <dd class="col-sm-7">@Model.Alumno?.Nombre @Model.Alumno?.Apellido</dd>

        <dt class="col-sm-5">Mes / Año</dt>
        <dd class="col-sm-7">@Model.Mes / @Model.Anio</dd>

        <dt class="col-sm-5">Monto</dt>
        <dd class="col-sm-7">$@Model.Monto</dd>

        <dt class="col-sm-5">Vencimiento</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.FechaVencimiento)</dd>

        <dt class="col-sm-5">Estado</dt>
        <dd class="col-sm-7">@Model.Estado</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>