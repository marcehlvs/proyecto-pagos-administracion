@model pagos_administracion_mvc.Models.Cuota
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Detalle de Cuota";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Detalle de Cuota</h1>
    <div>
        @if (Model.Estado == EstadoCuota.Pendiente || Model.Estado == EstadoCuota.Vencida || Model.Estado == EstadoCuota.Parcial)
        {
            // Botón de WhatsApp
            var telefono = Model.Alumno?.FamiliaUser?.PhoneNumber;
            if (!string.IsNullOrEmpty(telefono))
            {
                var montoAviso = Model.Estado == EstadoCuota.Parcial ? Model.SaldoPendiente : Model.Monto;
                var mensaje = Uri.EscapeDataString($"Hola Familia de {Model.Alumno?.Nombre}, te recordamos que la cuota de {Model.Mes}/{Model.Anio} tiene un saldo de {montoAviso:C} {(Model.Estado == EstadoCuota.Vencida ? "vencido" : Model.Estado == EstadoCuota.Parcial ? "pendiente" : "por pagar")}.");
                <a href="https://wa.me/@telefono?text=@mensaje" target="_blank" class="btn btn-outline-success me-2">
                    <i class="bi bi-whatsapp"></i> Contactar
                </a>
            }

            // Botón Registrar Pago Manual
            <a asp-controller="Pagos" asp-action="RegistrarManual" asp-route-cuotaId="@Model.Id" class="btn btn-success me-2">Registrar pago manual</a>
        }
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
    </div>
</div>

<div class="card p-4 mb-3" style="max-width: 600px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Alumno</dt>
        <dd class="col-sm-8">@Model.Alumno?.Apellido, @Model.Alumno?.Nombre</dd>

        <dt class="col-sm-4">Período</dt>
        <dd class="col-sm-8">@Model.Mes / @Model.Anio</dd>

        <dt class="col-sm-4">Monto</dt>
        <dd class="col-sm-8">@Model.Monto.ToString("C")</dd>
        @if (Model.Estado == EstadoCuota.Parcial)
        {
            <dt class="col-sm-4">Pagado</dt>
            <dd class="col-sm-8">@Model.TotalPagado.ToString("C")</dd>

            <dt class="col-sm-4">Saldo pendiente</dt>
            <dd class="col-sm-8 fw-bold">@Model.SaldoPendiente.ToString("C")</dd>
        }

        <dt class="col-sm-4">Vencimiento</dt>
        <dd class="col-sm-8">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">
            @if (Model.Estado == EstadoCuota.Pagada)
            {
                <span class="badge bg-success">Pagada</span>
            }
            else if (Model.Estado == EstadoCuota.Vencida)
            {
                <span class="badge bg-danger">Vencida</span>
            }
            else if (Model.Estado == EstadoCuota.Parcial)
            {
                <span class="badge bg-primary">Parcial</span>
            }
            else
            {
                <span class="badge bg-secondary">@Model.Estado</span>
            }
        </dd>
    </dl>

    <hr class="my-3" />

    <!-- Mini Formulario de Registro de Contacto -->
    <h6 class="mb-2">Registrar contacto manual</h6>
    <form asp-controller="Cuotas" asp-action="RegistrarContacto" method="post" class="row g-2 align-items-end mb-2">
        <input type="hidden" name="cuotaId" value="@Model.Id" />
        <div class="col-auto">
            <select name="medio" class="form-select form-select-sm">
                <option>WhatsApp</option>
                <option>Llamada</option>
                <option>Presencial</option>
            </select>
        </div>
        <div class="col-auto">
            <input type="text" name="notas" class="form-control form-control-sm" placeholder="Notas (opcional)" style="width: 250px;" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Registrar</button>
        </div>
    </form>

    <!-- Lista de contactos registrados -->
    @if (Model.ContactosManuales != null && Model.ContactosManuales.Any())
    {
        <ul class="list-group list-group-flush mt-2">
            @foreach (var contacto in Model.ContactosManuales.OrderByDescending(c => c.Fecha))
            {
                <li class="list-group-item small px-0 bg-transparent border-light">
                    <span class="text-muted">@contacto.Fecha.ToString("dd/MM/yy HH:mm")</span> —
                    <strong>@contacto.Medio</strong>
                    @if (!string.IsNullOrEmpty(contacto.Notas))
                    {
                        <span class="fst-italic text-muted">(@contacto.Notas)</span>
                    }
                    @if (!string.IsNullOrEmpty(contacto.RegistradoPorNombre))
                    {
                        <span class="text-muted"> · @contacto.RegistradoPorNombre</span>
                    }
                </li>
            }
        </ul>
    }
</div>

@if (Model.Pagos != null && Model.Pagos.Any())
{
    <h4 class="mt-4 mb-3">Historial de Pagos</h4>
    <div class="card p-0" style="max-width: 600px;">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Registrado por</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pago in Model.Pagos.OrderByDescending(p => p.Fecha))
                {
                    <tr>
                        <td>@pago.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pago.Monto.ToString("C")</td>
                        <td>@pago.Estado</td>
                        <td class="small text-muted">@(pago.RegistradoPorNombre ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted mt-3">No hay pagos registrados para esta cuota.</p>
}

<p class="text-muted small mt-3">
    Creada por @(Model.CreadaPorNombre ?? "—") el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
    @if (Model.FechaModificacion.HasValue)
    {
        <text> · Última edición: @Model.ModificadaPorNombre el @Model.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")</text>
    }
</p>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>