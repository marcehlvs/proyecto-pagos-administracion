@model pagos_administracion_mvc.Models.Cuota
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Detalle de Cuota";

    var (badgeCss, iconoCss, colorFg, colorBg) = Model.Estado switch
    {
        EstadoCuota.Pagada  => ("bg-success-subtle text-success-emphasis border-success-subtle",      "bi-check-circle-fill text-success",     "var(--bs-success)", "rgba(25,135,84,.08)"),
        EstadoCuota.Vencida => ("bg-danger-subtle text-danger-emphasis border-danger-subtle",         "bi-exclamation-circle-fill text-danger", "var(--bs-danger)",  "rgba(220,53,69,.08)"),
        EstadoCuota.Parcial => ("bg-primary-subtle text-primary-emphasis border-primary-subtle",      "bi-circle-half text-primary",            "var(--bs-primary)", "rgba(13,110,253,.08)"),
        _                   => ("bg-warning-subtle text-warning-emphasis border-warning-subtle",      "bi-clock-fill text-warning",             "var(--bs-warning)", "rgba(255,193,7,.08)")
    };

    bool puedeRegistrarPago = Model.Estado == EstadoCuota.Pendiente
                              || Model.Estado == EstadoCuota.Vencida
                              || Model.Estado == EstadoCuota.Parcial;
    var montoAviso = Model.Estado == EstadoCuota.Parcial ? Model.SaldoPendiente : Model.Monto;
    var telefono   = Model.Alumno?.FamiliaUser?.PhoneNumber;
}

@* ── Encabezado ── *@
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Lista
        </a>
        <h1 class="h5 fw-bold mb-0 text-body">
            Cuota @Model.Mes/@Model.Anio
            <span class="text-muted fw-normal">— @Model.Alumno?.Apellido, @Model.Alumno?.Nombre</span>
        </h1>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (puedeRegistrarPago && !string.IsNullOrEmpty(telefono))
        {
            var mensaje = Uri.EscapeDataString($"Hola Familia de {Model.Alumno?.Nombre}, te recordamos que la cuota de {Model.Mes}/{Model.Anio} tiene un saldo de {montoAviso:C} {(Model.Estado == EstadoCuota.Vencida ? "vencido" : Model.Estado == EstadoCuota.Parcial ? "pendiente" : "por pagar")}.");
            <a href="https://wa.me/@telefono?text=@mensaje" target="_blank"
               class="btn btn-outline-success rounded-pill px-3">
                <i class="bi bi-whatsapp me-1"></i>Contactar
            </a>
        }
        @if (puedeRegistrarPago)
        {
            <a asp-controller="Pagos" asp-action="RegistrarManual" asp-route-cuotaId="@Model.Id"
               class="btn btn-success rounded-pill px-3">
                <i class="bi bi-cash-coin me-1"></i>Registrar pago manual
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary rounded-pill px-3">
            <i class="bi bi-pencil-fill me-1"></i>Editar
        </a>
    </div>
</div>

<div class="row g-4 align-items-start" style="max-width:980px;">

    @* Columna izquierda: estado visual *@
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4" style="background:@colorBg;">
            <div class="mb-2" style="font-size:2.4rem;"><i class="bi @iconoCss"></i></div>
            <span class="badge rounded-pill px-3 py-2 border @badgeCss mb-3" style="font-size:.82rem;">@Model.Estado</span>
            <div class="fs-4 fw-bold" style="color:@colorFg;">@Model.Monto.ToString("C")</div>
            <div class="text-muted small mt-1">Vence @Model.FechaVencimiento.ToString("dd/MM/yyyy")</div>
            @if (Model.Estado == EstadoCuota.Parcial)
            {
                <hr class="my-2" />
                <div class="small text-muted">Pagado: <strong class="text-success">@Model.TotalPagado.ToString("C")</strong></div>
                <div class="small text-muted">Saldo: <strong class="text-danger">@Model.SaldoPendiente.ToString("C")</strong></div>
            }
        </div>
    </div>

    @* Columna derecha *@
    <div class="col-12 col-md-9 d-flex flex-column gap-4">

        @* Datos de la cuota *@
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h3 class="h6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing:.06em;font-size:.72rem;">
                <i class="bi bi-person-badge me-2"></i>Datos del alumno y período
            </h3>
            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="det-info-item">
                        <span class="det-info-label">Alumno</span>
                        <span class="det-info-value">@Model.Alumno?.Apellido, @Model.Alumno?.Nombre</span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="det-info-item">
                        <span class="det-info-label">Período</span>
                        <span class="det-info-value">@Model.Mes / @Model.Anio</span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="det-info-item">
                        <span class="det-info-label">Vencimiento</span>
                        <span class="det-info-value">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        @* Registrar contacto + historial *@
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h3 class="h6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing:.06em;font-size:.72rem;">
                <i class="bi bi-chat-dots me-2"></i>Contactos registrados
            </h3>
            <form asp-controller="Cuotas" asp-action="RegistrarContacto" method="post"
                  class="d-flex flex-wrap gap-2 align-items-end mb-3">
                <input type="hidden" name="cuotaId" value="@Model.Id" />
                <select name="medio" class="form-select form-select-sm" style="width:auto;">
                    <option>WhatsApp</option>
                    <option>Llamada</option>
                    <option>Presencial</option>
                </select>
                <input type="text" name="notas" class="form-control form-control-sm"
                       placeholder="Notas (opcional)" style="min-width:200px;max-width:320px;" />
                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i>Registrar
                </button>
            </form>

            @if (Model.ContactosManuales != null && Model.ContactosManuales.Any())
            {
                <div class="d-flex flex-column gap-1">
                    @foreach (var c in Model.ContactosManuales.OrderByDescending(c => c.Fecha))
                    {
                        <div class="d-flex align-items-center gap-2 py-2 border-bottom">
                            <span class="badge bg-body-secondary text-body rounded-pill" style="font-size:.72rem;">@c.Medio</span>
                            <span class="text-muted small">@c.Fecha.ToString("dd/MM/yy HH:mm")</span>
                            @if (!string.IsNullOrEmpty(c.Notas))
                            {
                                <span class="text-muted small fst-italic">— @c.Notas</span>
                            }
                            @if (!string.IsNullOrEmpty(c.RegistradoPorNombre))
                            {
                                <span class="ms-auto text-muted small">@c.RegistradoPorNombre</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small fst-italic">Sin contactos registrados aún.</div>
            }
        </div>

        @* Historial de pagos *@
        @if (Model.Pagos != null && Model.Pagos.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h3 class="h6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing:.06em;font-size:.72rem;">
                    <i class="bi bi-clock-history me-2"></i>Historial de pagos
                </h3>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold small">Fecha</th>
                                <th class="fw-semibold small">Monto</th>
                                <th class="fw-semibold small">Estado</th>
                                <th class="fw-semibold small">Registrado por</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model.Pagos.OrderByDescending(p => p.Fecha))
                            {
                                var pBadge = pago.Estado switch
                                {
                                    EstadoPago.Aprobado   => "bg-success-subtle text-success-emphasis",
                                    EstadoPago.Rechazado  => "bg-danger-subtle text-danger-emphasis",
                                    EstadoPago.EnRevision => "bg-warning-subtle text-warning-emphasis",
                                    _                     => "bg-secondary-subtle text-secondary-emphasis"
                                };
                                <tr>
                                    <td class="small">@pago.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small fw-semibold">@pago.Monto.ToString("C")</td>
                                    <td><span class="badge rounded-pill @pBadge">@pago.Estado</span></td>
                                    <td class="small text-muted">@(pago.RegistradoPorNombre ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Auditoría *@
        <p class="text-muted small mb-0">
            <i class="bi bi-person me-1"></i>Creada por @(Model.CreadaPorNombre ?? "—") el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
            @if (Model.FechaModificacion.HasValue)
            {
                <text> · <i class="bi bi-pencil me-1"></i>Editada por @Model.ModificadaPorNombre el @Model.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")</text>
            }
        </p>

    </div>
</div>

<style>
    .det-info-item {
        display:flex; flex-direction:column; gap:2px;
        padding:.55rem .75rem;
        background:var(--bs-body-bg);
        border:1px solid var(--bs-border-color-translucent);
        border-radius:.6rem; transition:background .18s;
    }
    .det-info-item:hover { background:var(--bs-tertiary-bg); }
    .det-info-label { font-size:.68rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--bs-secondary-color); }
    .det-info-value { font-size:.92rem; font-weight:500; color:var(--bs-body-color); }
</style>