@model pagos_administracion_mvc.Models.Cuota
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Detalle de Cuota";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Detalle de Cuota</h1>
    <div>
        @if (Model.Estado == EstadoCuota.Pendiente || Model.Estado == EstadoCuota.Vencida)
        {
            <a asp-controller="Pagos" asp-action="RegistrarManual" asp-route-cuotaId="@Model.Id" class="btn btn-success me-2">Registrar pago manual</a>
        }
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
    </div>
</div>

<div class="card p-4 mb-3" style="max-width: 600px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Alumno</dt>
        <dd class="col-sm-8">@Model.Alumno?.Apellido, @Model.Alumno?.Nombre</dd>

        <dt class="col-sm-4">Período</dt>
        <dd class="col-sm-8">@Model.Mes / @Model.Anio</dd>

        <dt class="col-sm-4">Monto</dt>
        <dd class="col-sm-8">@Model.Monto.ToString("C")</dd>

        <dt class="col-sm-4">Vencimiento</dt>
        <dd class="col-sm-8">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">
            @if (Model.Estado == EstadoCuota.Pagada)
            {
                <span class="badge bg-success">Pagada</span>
            }
            else if (Model.Estado == EstadoCuota.Vencida)
            {
                <span class="badge bg-danger">Vencida</span>
            }
            else
            {
                <span class="badge bg-secondary">@Model.Estado</span>
            }
        </dd>
    </dl>
</div>

@if (Model.Pagos != null && Model.Pagos.Any())
{
    <h4 class="mt-4 mb-3">Historial de Pagos</h4>
    <div class="card p-0" style="max-width: 600px;">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pago in Model.Pagos.OrderByDescending(p => p.Fecha))
                {
                    <tr>
                        <td>@pago.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pago.Monto.ToString("C")</td>
                        <td>@pago.Estado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted mt-3">No hay pagos registrados para esta cuota.</p>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>