@{
    ViewData["Title"] = "Boletín";
    var alumnos = (List<pagos_administracion_mvc.Models.Alumno>)ViewBag.Alumnos;
    int? alumnoIdSeleccionado = ViewBag.AlumnoIdSeleccionado;
    var anio = (int)ViewBag.AnioLectivo;
}

<h1>Boletín</h1>

<div class="card p-4" style="max-width: 500px;">
    <form asp-action="Pdf" method="get" target="_blank">
        @if (User.IsInRole("Admin") || User.IsInRole("Preceptor") || alumnos.Count > 1)
        {
            <div class="mb-3">
                <label class="form-label">Alumno</label>
                <select name="alumnoId" class="form-select" required>
                    <option value="">Seleccioná un alumno...</option>
                    @foreach (var a in alumnos)
                    {
                        <option value="@a.Id" selected="@(alumnoIdSeleccionado == a.Id)">@a.Apellido, @a.Nombre</option>
                    }
                </select>
            </div>
        }
        else if (alumnos.Count == 1)
        {
            <input type="hidden" name="alumnoId" value="@alumnos[0].Id" />
            <p>Alumno: <strong>@alumnos[0].Apellido, @alumnos[0].Nombre</strong></p>
        }
        else
        {
            <p class="text-muted">No hay ningún alumno vinculado a este usuario.</p>
        }

        <div class="mb-3">
            <label class="form-label">Año lectivo</label>
            <input type="number" name="anioLectivo" class="form-control" value="@anio" />
        </div>

        <div class="mb-3">
            <label class="form-label">Formato</label>
            <select name="plantilla" class="form-select">
                <option value="">Boletín institucional</option>
                <option value="rite">RITE (formulario oficial DGCyE)</option>
            </select>
            <div class="form-text">El RITE ya completa Valoración Preliminar e Inasistencias si el Docente/Preceptor las cargaron; Intensificación y materias pendientes de años anteriores todavía quedan en blanco para completar a mano.</div>
        </div>

        <button type="submit" class="btn btn-primary" @(alumnos.Any() ? "" : "disabled")>Descargar PDF</button>
    </form>
</div>