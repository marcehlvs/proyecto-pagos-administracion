@{
    ViewData["Title"] = "Nosotros";
}

@* ══════════════════════════════════════════════════════════
     ENCABEZADO INSTITUCIONAL — sobrio, sin video
     ══════════════════════════════════════════════════════════ *@
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 rounded-4 px-4 py-4 mb-5"
     style="background-color: var(--color-primary-dark);">
    <div class="text-white">
        <h1 class="h4 fw-bold mb-0">Escuela José de San Martín</h1>
        <span class="text-white-50 small">Nuestra historia, valores y propuesta educativa</span>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm">
        <i class="bi bi-house me-1"></i>Volver al inicio
    </a>
</div>

@* ══════════════════════════════════════════════════════════
     TARJETAS INSTITUCIONALES
     ══════════════════════════════════════════════════════════ *@
<div class="row g-4 mb-5">

    <div class="col-md-4">
        <div class="card h-100 rounded-4 border-0 shadow-sm institutional-card overflow-hidden">
            <div class="institutional-accent" style="background: linear-gradient(90deg, var(--color-primary, #0d6efd), var(--color-primary-dark, #0a58ca));"></div>
            <div class="card-body p-4">
                <div class="fs-1 mb-3">🏛️</div>
                <h3 class="h5 fw-bold mb-3">Nuestra Historia</h3>
                <p class="text-muted mb-0">
                    Fundada en 1976, la Escuela José de San Martín nace con el compromiso de brindar una educación de calidad,
                    formando ciudadanos críticos, responsables y comprometidos con su comunidad. A lo largo de las décadas,
                    hemos evolucionado incorporando nuevas tecnologías y metodologías pedagógicas, manteniendo intacta
                    nuestra esencia fundacional.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 rounded-4 border-0 shadow-sm institutional-card overflow-hidden">
            <div class="institutional-accent" style="background: linear-gradient(90deg, #0d6efd, #6610f2);"></div>
            <div class="card-body p-4">
                <span class="badge bg-primary rounded-pill mb-3">Nivel Inicial y Primario</span>
                <div class="fs-1 mb-3">🌱</div>
                <h3 class="h5 fw-bold mb-3">Valores Formativos</h3>
                <p class="text-muted mb-0">
                    Acompañamos a los niños en sus primeros pasos, fomentando la curiosidad, el respeto y la solidaridad
                    como pilares para su desarrollo integral. Creemos que una buena base es la clave para el futuro.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 rounded-4 border-0 shadow-sm institutional-card overflow-hidden">
            <div class="institutional-accent" style="background: linear-gradient(90deg, #198754, #20c997);"></div>
            <div class="card-body p-4">
                <span class="badge bg-success rounded-pill mb-3">Nivel Secundario</span>
                <div class="fs-1 mb-3">🚀</div>
                <h3 class="h5 fw-bold mb-3">Enfoque Educativo</h3>
                <p class="text-muted mb-0">
                    Nuestro enfoque para el nivel secundario se centra en preparar a los estudiantes para los desafíos del futuro,
                    integrando una sólida formación académica con el desarrollo de habilidades blandas y pensamiento crítico.
                </p>
            </div>
        </div>
    </div>

</div>

<style>
    .institutional-accent {
        height: 5px;
    }
    .institutional-card {
        transition: transform .22s ease, box-shadow .22s ease;
    }
    .institutional-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 28px rgba(0,0,0,.12) !important;
    }
</style>