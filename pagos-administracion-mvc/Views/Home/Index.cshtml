@* ════════════════════════════════════════════════════════════
     ESTILOS SCOPED (solo en esta vista, no contamina el layout)
     ════════════════════════════════════════════════════════════ *@
<style>
    /* ── Quick-access cards ──────────────────────────────── */
    .quick-card {
        transition: transform .22s ease, box-shadow .22s ease, background-color .18s ease;
    }

        .quick-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 10px 28px rgba(0,0,0,.13) !important;
            background-color: var(--bs-primary-bg-subtle, #e9f0ff) !important;
        }

    .quick-card__icon {
        transition: transform .22s ease;
    }

    .quick-card:hover .quick-card__icon {
        transform: scale(1.15);
    }

    /* ── Aviso cards ─────────────────────────────────────── */
    .aviso-card {
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .aviso-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 18px rgba(0,0,0,.1) !important;
        }
</style>