@using pagos_administracion_mvc.Models
@{
    ViewData["Title"] = "Inicio";
}

@* ═══════════════════════════════════════════════════════════
     HERO — intacto en estructura, mantenemos el video de fondo
     ═══════════════════════════════════════════════════════════ *@
<div class="position-relative rounded-4 overflow-hidden mb-5 text-white" style="min-height: 380px;">
    <video autoplay muted loop playsinline class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover; object-position: center 20%; z-index: -2;">
        <source src="~/videos/@ViewBag.HeroVideo" type="video/mp4">
    </video>
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0, 32, 69, 0.75); z-index: -1;"></div>

    <div class="p-5 d-flex flex-column justify-content-center h-100">
        <span class="badge bg-light text-dark mb-3 align-self-start">CICLO LECTIVO 2026</span>
        <h1 class="display-6 fw-bold">Escuela José de San Martín</h1>
        <p class="col-md-8 fs-5">Formando el futuro con valores y excelencia académica desde el nivel inicial hasta el secundario.</p>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("Familia"))
            {
                <a asp-controller="MisCuotas" asp-action="Index" class="btn btn-success btn-lg">Portal de Pagos</a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Cuotas" asp-action="Index" class="btn btn-success btn-lg">Portal de Pagos</a>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success btn-lg">Portal de Pagos</a>
            }
            <a asp-controller="Home" asp-action="Nosotros" class="btn btn-outline-light btn-lg">Conocé nuestra propuesta</a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════
     CONTADORES — tarjetas con acento de color, sombra
     y animación de hover
     ═══════════════════════════════════════════════════ *@
<div class="row g-4 mb-5">
    <div class="col-6">
        <div class="stat-card card rounded-4 shadow-sm border-0 h-100 overflow-hidden">
            <div class="stat-card__accent"></div>
            <div class="card-body text-center py-4">
                <div class="stat-card__number fs-1 fw-bold lh-1 mb-1">@ViewBag.CantidadAlumnos</div>
                <div class="text-muted text-uppercase small fw-semibold ls-wide">Alumnos</div>
            </div>
        </div>
    </div>
    <div class="col-6">
        <div class="stat-card card rounded-4 shadow-sm border-0 h-100 overflow-hidden">
            <div class="stat-card__accent stat-card__accent--gold"></div>
            <div class="card-body text-center py-4">
                <div class="stat-card__number fs-1 fw-bold lh-1 mb-1">50 Años</div>
                <div class="text-muted text-uppercase small fw-semibold ls-wide">De excelencia</div>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    var pagosRecientes = (List<pagos_administracion_mvc.Models.Pago>)ViewBag.PagosRecientes;
    var comprobantesPendientes = (List<pagos_administracion_mvc.Models.Pago>)ViewBag.ComprobantesPendientes;

    @if (comprobantesPendientes.Any())
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4 rounded-4 border-0 shadow-sm">
            <span><i class="bi bi-exclamation-triangle-fill"></i> Tenés <strong>@comprobantesPendientes.Count</strong> comprobante(s) esperando revisión.</span>
            <a asp-controller="Pagos" asp-action="Index" class="btn btn-sm btn-warning rounded-3">Revisar ahora</a>
        </div>
    }

    <div class="card rounded-4 shadow-sm border-0 p-3 mb-5">
        <h6 class="mb-3 fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Pagos aprobados (últimas 48hs)</h6>
        @if (!pagosRecientes.Any())
        {
            <p class="text-muted small mb-0">Sin pagos aprobados en este período.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var pago in pagosRecientes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>@pago.Cuota.Alumno.Apellido, @pago.Cuota.Alumno.Nombre — Cuota @pago.Cuota.Mes/@pago.Cuota.Anio</span>
                        <span class="text-muted small">@pago.Monto.ToString("C") · @pago.Fecha.ToString("dd/MM HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </div>
}

@* ═════════════════════════════════════════════
     PODCAST — Video central, rotación y Modal
     ═════════════════════════════════════════════ *@
<section class="mb-5">
    <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
        <span class="podcast-badge badge rounded-pill px-3 py-2 fs-6">
            <i class="bi bi-play-circle-fill me-1"></i>Podcast
        </span>
        <h2 class="h4 fw-bold mb-0">San Martín en Corto</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="podcast-card card border-0 rounded-4 shadow-sm overflow-hidden">
                @* Contenedor del video con botón Play superpuesto *@
                <div class="position-relative" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#podcastModal" onclick="abrirModalVideo()">
                    <video id="videoDestacado" class="w-100" style="display:block; aspect-ratio:9/16; object-fit:cover; max-height:380px;" autoplay loop muted playsinline>
                        <source src="~/videos/podcast-ep1.mp4" type="video/mp4">
                    </video>
                    <div class="position-absolute top-50 start-50 translate-middle">
                        <div class="bg-dark bg-opacity-75 rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; backdrop-filter: blur(4px);">
                            <i class="bi bi-play-fill text-white fs-1"></i>
                        </div>
                    </div>
                </div>

                @* Descripción y botón rotativo *@
                <div class="card-body pb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span id="badgeEpisodio" class="badge bg-primary-subtle text-primary-emphasis rounded-pill">Ep. 01</span>
                        <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="siguienteEpisodio()">Ver siguiente <i class="bi bi-arrow-right"></i></button>
                    </div>
                    <h6 id="tituloEpisodio" class="fw-semibold mb-1">Historia de nuestra escuela</h6>
                    <p id="descEpisodio" class="text-muted small mb-0">Un recorrido por los 50 años de trayectoria educativa.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Modal para reproducir el video en grande (con audio) ── *@
<div class="modal fade" id="podcastModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0 text-center">
                <video id="videoModal" class="w-100 rounded-4 shadow-lg" controls style="max-height: 85vh; background: #000;">
                    <!-- El src se inyecta por JS al hacer clic -->
                </video>
            </div>
        </div>
    </div>
</div>
@* ═══════════════════════════════════════════
     AVISOS — con nuevo estilo de tarjetas
     ═══════════════════════════════════════════ *@
<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="h4 fw-bold mb-0"><i class="bi bi-megaphone me-2"></i>Novedades y Avisos</h2>
</div>
<div class="row g-3 mb-5">
    @{
        var avisos = (List<Aviso>)ViewBag.Avisos;
    }
    @if (!avisos.Any())
    {
        <p class="text-muted">No hay avisos publicados por el momento.</p>
    }
    @foreach (var aviso in avisos)
    {
        var (borderClass, badgeClass, iconClass) = aviso.Tipo switch
        {
            TipoAviso.Importante => ("border-success", "bg-success", "bi-check-circle-fill text-success"),
            TipoAviso.Calendario => ("border-warning", "bg-warning text-dark", "bi-calendar-event-fill text-warning"),
            _                    => ("border-danger",  "bg-danger",  "bi-exclamation-circle-fill text-danger")
        };
        <div class="col-md-4">
            <div class="card rounded-4 shadow-sm border-0 border-start @borderClass border-4 h-100 aviso-card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi @iconClass fs-5"></i>
                        <span class="badge @badgeClass rounded-pill">@aviso.Tipo</span>
                    </div>
                    <strong class="d-block mb-1">@aviso.Titulo</strong>
                    <p class="text-muted mb-0 small">@aviso.Descripcion</p>
                </div>
            </div>
        </div>
    }
</div>

