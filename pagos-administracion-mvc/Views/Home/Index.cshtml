@using pagos_administracion_mvc.Models
@{
    ViewData["Title"] = "Inicio";
}

@* ══════════════════════════════════════════════════════════════════
     HERO — video de fondo con overlay oscuro, impacto institucional
     ══════════════════════════════════════════════════════════════════ *@
<div class="hero-wrapper position-relative rounded-4 overflow-hidden mb-4 text-white" style="min-height: 320px;">
    <video autoplay muted loop playsinline
           class="position-absolute top-0 start-0 w-100 h-100"
           style="object-fit: cover; object-position: center 20%; z-index: -2;">
        <source src="~/videos/@ViewBag.HeroVideo" type="video/mp4">
    </video>
    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background: linear-gradient(135deg, rgba(0,32,69,0.82) 0%, rgba(0,62,120,0.65) 100%); z-index: -1;">
    </div>

    <div class="px-5 py-4 d-flex flex-column justify-content-center h-100" style="min-height: 320px;">
        <span class="badge bg-light text-dark mb-3 align-self-start animate-fadein">CICLO LECTIVO 2026</span>
        <h1 class="display-5 fw-bold mb-2 animate-fadein" style="animation-delay:.1s">
            Escuela José de San Martín
        </h1>
        <p class="col-md-7 fs-5 mb-4 text-white-75 animate-fadein" style="animation-delay:.2s">
            Formando el futuro con valores y excelencia académica desde el nivel inicial hasta el secundario.
        </p>
        <div class="d-flex gap-3 flex-wrap animate-fadein" style="animation-delay:.3s">
            @if (User.IsInRole("Familia"))
            {
                <a asp-controller="MisCuotas" asp-action="Index" class="btn btn-success btn-lg px-4 hero-btn">
                    <i class="bi bi-credit-card me-2"></i>Portal de Pagos
                </a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Cuotas" asp-action="Index" class="btn btn-success btn-lg px-4 hero-btn">
                    <i class="bi bi-credit-card me-2"></i>Portal de Pagos
                </a>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success btn-lg px-4 hero-btn">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar al Portal
                </a>
            }
            <a asp-controller="Home" asp-action="Nosotros" class="btn btn-outline-light btn-lg px-4 hero-btn">
                Conocé nuestra propuesta
            </a>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════
     CONTADORES — alumnos y años de trayectoria
     ══════════════════════════════════════════════════ *@
<div class="row g-3 mb-4">
    <div class="col-6">
        <div class="stat-card card rounded-4 shadow-sm border-0 h-100 overflow-hidden">
            <div class="stat-card__accent"></div>
            <div class="card-body text-center py-4">
                <div class="stat-card__number fs-1 fw-bold lh-1 mb-1">@ViewBag.CantidadAlumnos</div>
                <div class="text-muted text-uppercase small fw-semibold ls-wide">Alumnos</div>
            </div>
        </div>
    </div>
    <div class="col-6">
        <div class="stat-card card rounded-4 shadow-sm border-0 h-100 overflow-hidden">
            <div class="stat-card__accent stat-card__accent--gold"></div>
            <div class="card-body text-center py-4">
                <div class="stat-card__number stat-card__number--gold fs-1 fw-bold lh-1 mb-1">50 Años</div>
                <div class="text-muted text-uppercase small fw-semibold ls-wide">De excelencia</div>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════
     ZONA OPERATIVA — solo visible para usuarios autenticados
     Separador visual sutil que marca el paso de "landing" a "app"
     ══════════════════════════════════════════════════════════════════ *@
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="operational-divider d-flex align-items-center gap-3 mb-4">
        <div class="flex-grow-1" style="height:1px; background: linear-gradient(90deg, transparent, var(--bs-border-color) 40%, var(--bs-border-color) 60%, transparent);"></div>
        <span class="badge rounded-pill px-3 py-2 text-bg-secondary opacity-75 fw-normal small">
            <i class="bi bi-person-check me-1"></i>Tu espacio
        </span>
        <div class="flex-grow-1" style="height:1px; background: linear-gradient(90deg, transparent, var(--bs-border-color) 40%, var(--bs-border-color) 60%, transparent);"></div>
    </div>

    @* ── Admin: alerta de comprobantes + pagos recientes ── *@
    @if (User.IsInRole("Admin"))
    {
        var pagosRecientes = (List<pagos_administracion_mvc.Models.Pago>)ViewBag.PagosRecientes;
        var comprobantesPendientes = (List<pagos_administracion_mvc.Models.Pago>)ViewBag.ComprobantesPendientes;

        @if (comprobantesPendientes.Any())
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center mb-3 rounded-4 border-0 shadow-sm">
                <span>
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Tenés <strong>@comprobantesPendientes.Count</strong> comprobante(s) esperando revisión.
                </span>
                <a asp-controller="Pagos" asp-action="Index" class="btn btn-sm btn-warning rounded-3 ms-3 flex-shrink-0">
                    <i class="bi bi-eye me-1"></i>Revisar ahora
                </a>
            </div>
        }

        <div class="card rounded-4 shadow-sm border-0 p-3 mb-4">
            <h6 class="mb-3 fw-semibold">
                <i class="bi bi-clock-history me-2 text-primary"></i>Pagos aprobados — últimas 48 hs
            </h6>
            @if (!pagosRecientes.Any())
            {
                <p class="text-muted small mb-0">Sin pagos aprobados en este período.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var pago in pagosRecientes)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>@pago.Cuota.Alumno.Apellido, @pago.Cuota.Alumno.Nombre — Cuota @pago.Cuota.Mes/@pago.Cuota.Anio</span>
                            <span class="text-muted small text-nowrap ms-3">@pago.Monto.ToString("C") · @pago.Fecha.ToString("dd/MM HH:mm")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @* ── Accesos rápidos (todos los roles) ── *@
    <div class="mb-5">
        <h2 class="h5 fw-bold mb-3">
            <i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Accesos Rápidos
        </h2>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a asp-controller="Home" asp-action="Calendario"
                   class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                    <div class="quick-card__icon fs-1 mb-2">📅</div>
                    <div class="fw-semibold small">Calendario Escolar</div>
                </a>
            </div>

            @if (User.IsInRole("Familia"))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="MisCuotas" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">💳</div>
                        <div class="fw-semibold small">Mis Cuotas</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="MisTareas" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📝</div>
                        <div class="fw-semibold small">Tareas</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Boletines" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📄</div>
                        <div class="fw-semibold small">Boletín</div>
                    </a>
                </div>
            }

            @if (User.IsInRole("Alumno"))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="MisAsistencias" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">✅</div>
                        <div class="fw-semibold small">Mis Asistencias</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="MisTareas" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📝</div>
                        <div class="fw-semibold small">Tareas</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Boletines" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📄</div>
                        <div class="fw-semibold small">Boletín</div>
                    </a>
                </div>
            }

            @if (User.IsInRole("Docente"))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Asistencias" asp-action="Resumen"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">🗓️</div>
                        <div class="fw-semibold small">Asistencias</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Notas" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">✏️</div>
                        <div class="fw-semibold small">Notas</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Tareas" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📝</div>
                        <div class="fw-semibold small">Tareas</div>
                    </a>
                </div>
            }

            @if (User.IsInRole("Preceptor"))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Asistencias" asp-action="Resumen"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">🗓️</div>
                        <div class="fw-semibold small">Asistencias</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="MateriasPendientes" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📋</div>
                        <div class="fw-semibold small">Materias Pendientes</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Boletines" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📄</div>
                        <div class="fw-semibold small">Boletín</div>
                    </a>
                </div>
            }

            @if (User.IsInRole("Admin"))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📊</div>
                        <div class="fw-semibold small">Dashboard</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Cursos" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">🏫</div>
                        <div class="fw-semibold small">Cursos</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Boletines" asp-action="Publicaciones"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📄</div>
                        <div class="fw-semibold small">Publicar Boletines</div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="MateriasPendientes" asp-action="Index"
                       class="quick-card card rounded-4 shadow-sm border-0 p-4 text-center text-decoration-none d-block h-100">
                        <div class="quick-card__icon fs-1 mb-2">📋</div>
                        <div class="fw-semibold small">Materias Pendientes</div>
                    </a>
                </div>
            }
        </div>
    </div>
}

@* ══════════════════════════════════════════════════
     AVISOS — siempre visible, diseño tipo "feed"
     ══════════════════════════════════════════════════ *@
@{
    var avisos = (List<Aviso>)ViewBag.Avisos;
}
@if (avisos != null && avisos.Any())
{
    <div class="mb-5">
        <h2 class="h5 fw-bold mb-3">
            <i class="bi bi-megaphone me-2 text-primary"></i>Novedades y Avisos
        </h2>
        <div class="row g-3">
            @foreach (var aviso in avisos)
            {
                var (borderClass, badgeClass, iconClass) = aviso.Tipo switch
                {
                    TipoAviso.Importante => ("border-success", "bg-success", "bi-check-circle-fill text-success"),
                    TipoAviso.Calendario => ("border-warning", "bg-warning text-dark", "bi-calendar-event-fill text-warning"),
                    _ => ("border-danger", "bg-danger", "bi-exclamation-circle-fill text-danger")
                };
                <div class="col-md-4">
                    <div class="aviso-card card rounded-4 shadow-sm border-0 border-start @borderClass border-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi @iconClass fs-5"></i>
                                <span class="badge @badgeClass rounded-pill">@aviso.Tipo</span>
                            </div>
                            <strong class="d-block mb-1">@aviso.Titulo</strong>
                            <p class="text-muted mb-0 small">@aviso.Descripcion</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════
     PODCAST — "San Martín en Corto", cierre narrativo institucional
     ══════════════════════════════════════════════════════════════════ *@
<section class="mb-5">
    <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
        <span class="podcast-badge badge rounded-pill px-3 py-2 fs-6">
            <i class="bi bi-play-circle-fill me-1"></i>Podcast
        </span>
        <h2 class="h4 fw-bold mb-0">San Martín en Corto</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="podcast-card card border-0 rounded-4 shadow-sm overflow-hidden">
                <div class="position-relative"
                     style="cursor: pointer;"
                     onclick="abrirModalVideo(event)">
                    <video id="videoDestacado" class="w-100"
                           style="display:block; aspect-ratio:9/16; object-fit:cover; max-height:380px;"
                           autoplay loop muted playsinline
                           poster="@(Url.Content("~/images/podcast-poster.jpg"))">
                        <source src="@(Url.Content("~/videos/podcast-ep1.mp4"))" type="video/mp4">
                    </video>
                    <div class="position-absolute top-50 start-50 translate-middle">
                        <div class="bg-dark bg-opacity-75 rounded-circle d-flex align-items-center justify-content-center"
                             style="width:64px; height:64px; backdrop-filter:blur(4px);">
                            <i class="bi bi-play-fill text-white fs-1"></i>
                        </div>
                    </div>
                    <button type="button"
                            id="btnMuteDestacado"
                            class="btn-mute"
                            onclick="toggleMuteDestacado(event)"
                            aria-label="Activar o silenciar sonido">
                        <i class="bi bi-volume-mute-fill"></i>
                    </button>
                </div>

                <div class="card-body pb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span id="badgeEpisodio" class="badge bg-primary-subtle text-primary-emphasis rounded-pill">Ep. 01</span>
                        <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="siguienteEpisodio()">
                            Ver siguiente <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                    <h6 id="tituloEpisodio" class="fw-semibold mb-1">Historia de nuestra escuela</h6>
                    <p id="descEpisodio" class="text-muted small mb-0">Un recorrido por los 50 años de trayectoria educativa.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Modal para reproducir el video en grande (con audio) ── *@
<div class="modal fade" id="podcastModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0 text-center">
                <video id="videoModal" class="w-100 rounded-4 shadow-lg"
                       controls style="max-height:85vh; background:#000;">
                </video>
            </div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
     ESTILOS SCOPED — no contaminan el layout
     ════════════════════════════════════════════════════════════ *@
<style>
    /* ── Hero ────────────────────────────────────────────── */
    .hero-wrapper {
        transition: box-shadow .3s ease;
    }
    .text-white-75 { color: rgba(255,255,255,.82); }

    .hero-btn {
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .hero-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,.22) !important;
    }

    /* Fade-in escalonado */
    .animate-fadein {
        opacity: 0;
        transform: translateY(12px);
        animation: fadeInUp .55s ease forwards;
    }
    @@keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    }

    /* ── Stat cards ──────────────────────────────────────── */
    .stat-card {
        transition: transform .22s ease, box-shadow .22s ease;
        cursor: default;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    }
    .stat-card__accent {
        height: 5px;
        background: linear-gradient(90deg, var(--color-primary, #0d6efd), var(--color-primary-dark, #0a58ca));
    }
    .stat-card__accent--gold {
        background: linear-gradient(90deg, #f5a623, #f7c948);
    }
    .stat-card__number {
        color: var(--color-primary, #0d6efd);
        letter-spacing: -1px;
    }
    .stat-card__number--gold {
        color: #c47d07;
    }

    /* ── Quick-access cards ──────────────────────────────── */
    .quick-card {
        transition: transform .22s ease, box-shadow .22s ease, background-color .18s ease;
    }
    .quick-card:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 10px 28px rgba(0,0,0,.13) !important;
        background-color: var(--bs-primary-bg-subtle, #e9f0ff) !important;
    }
    .quick-card__icon {
        transition: transform .22s ease;
    }
    .quick-card:hover .quick-card__icon {
        transform: scale(1.15);
    }

    /* ── Aviso cards ─────────────────────────────────────── */
    .aviso-card {
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .aviso-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 18px rgba(0,0,0,.1) !important;
    }

    /* ── Podcast section ─────────────────────────────────── */
    .podcast-badge {
        background: linear-gradient(135deg, var(--color-primary, #0d6efd), #6610f2);
        color: #fff;
        font-weight: 600;
    }
    .podcast-card {
        transition: transform .25s ease, box-shadow .25s ease;
    }
    .podcast-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 14px 36px rgba(0,0,0,.16) !important;
    }

    /* Botón flotante de volumen */
    .btn-mute {
        position: absolute;
        bottom: 12px;
        right: 12px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: rgba(0,0,0,.55);
        color: #fff;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(4px);
        transition: background .18s ease, transform .18s ease;
        z-index: 10;
    }
    .btn-mute:hover {
        background: rgba(0,0,0,.82);
        transform: scale(1.12);
    }
    .btn-mute:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
    }
</style>

@section Scripts {
<script>
    const episodios = [
        { src: '@(Url.Content("~/videos/podcast-ep1.mp4"))', ep: 'Ep. 01', titulo: 'Historia de nuestra escuela',   desc: 'Un recorrido por los 50 años de trayectoria educativa.' },
        { src: '@(Url.Content("~/videos/podcast-ep2.mp4"))', ep: 'Ep. 02', titulo: 'Voces del aula',                desc: 'Docentes y alumnos comparten su experiencia diaria.' },
        { src: '@(Url.Content("~/videos/podcast-ep3.mp4"))', ep: 'Ep. 03', titulo: 'El futuro empieza aquí',        desc: 'Proyectos y actividades que transforman la comunidad.' }
    ];
    let epActual = 0;

    function siguienteEpisodio() {
        epActual = (epActual + 1) % episodios.length;
        const data = episodios[epActual];
        const video = document.getElementById('videoDestacado');
        // Asignar src directamente en el elemento <video> es más confiable
        // en todos los browsers que modificar el <source> hijo.
        video.src = data.src;
        video.load();
        video.play().catch(() => {});
        document.getElementById('badgeEpisodio').innerText  = data.ep;
        document.getElementById('tituloEpisodio').innerText = data.titulo;
        document.getElementById('descEpisodio').innerText   = data.desc;
    }

    function abrirModalVideo(event) {
        if (event && event.target.closest('#btnMuteDestacado')) return;

        document.getElementById('videoDestacado').pause();

        // ── CLAVE: arrancar SIEMPRE silenciado. Es la única reproducción
        // automática que todos los navegadores garantizan (incluido modo
        // incógnito, donde Chrome es mucho más estricto con el audio y el
        // intento de reproducir con sonido puede fallar en silencio, sin
        // error visible, dejando el video pausado). El usuario activa el
        // sonido con el botón de volumen de los controles nativos.
        const modalVideo = document.getElementById('videoModal');
        modalVideo.muted = true;
        modalVideo.src   = episodios[epActual].src;
        modalVideo.load();

        // play() se llama en shown.bs.modal para que el elemento ya sea visible
        // cuando el browser renderiza el primer frame (evita pantalla negra).
        const modalEl = document.getElementById('podcastModal');
        modalEl.addEventListener('shown.bs.modal', function handler() {
            modalEl.removeEventListener('shown.bs.modal', handler);
            modalVideo.play().catch(function (err) {
                // Si esto falla, va a quedar registrado en la consola del
                // navegador (F12 → Console) en vez de fallar en silencio.
                console.error('No se pudo reproducir el podcast:', err);
            });
        });

        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    document.getElementById('podcastModal').addEventListener('hidden.bs.modal', function () {
        const modalVideo = document.getElementById('videoModal');
        modalVideo.pause();
        modalVideo.removeAttribute('src');
        modalVideo.load();

        // Al cerrar el modal, se retoma el preview silenciado como estaba
        // originalmente (evita que arranque con sonido activado).
        const videoPreview = document.getElementById('videoDestacado');
        videoPreview.muted = true;
        document.querySelector('#btnMuteDestacado i').className = 'bi bi-volume-mute-fill';
        videoPreview.play();
    });

    function toggleMuteDestacado(event) {
        // El contenedor ya no tiene data-bs-toggle="modal" (ver abrirModalVideo);
        // el modal grande no se abre más con este click. stopPropagation queda
        // igual para que el click no burbujee hacia el onclick del contenedor.
        event.preventDefault();
        event.stopPropagation();

        const video = document.getElementById('videoDestacado');
        const icono = document.querySelector('#btnMuteDestacado i');
        video.muted = !video.muted;
        icono.className = video.muted ? 'bi bi-volume-mute-fill' : 'bi bi-volume-up-fill';
    }
</script>
}