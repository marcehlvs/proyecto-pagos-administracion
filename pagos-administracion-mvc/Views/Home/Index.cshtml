@{
    ViewData["Title"] = "Inicio";
}

<div class="position-relative rounded-4 overflow-hidden mb-4 text-white" style="min-height: 380px;">
    <video autoplay muted loop playsinline class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover; object-position: center 20%; z-index: -2;">
        <source src="~/videos/@ViewBag.HeroVideo" type="video/mp4">
    </video>
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0, 32, 69, 0.75); z-index: -1;"></div>

    <div class="p-5 d-flex flex-column justify-content-center h-100">
        <span class="badge bg-light text-dark mb-3 align-self-start">CICLO LECTIVO 2026</span>
        <h1 class="display-6 fw-bold">Escuela José de San Martín</h1>
        <p class="col-md-8 fs-5">Formando el futuro con valores y excelencia académica desde el nivel inicial hasta el secundario.</p>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("Familia"))
            {
                <a asp-controller="MisCuotas" asp-action="Index" class="btn btn-success btn-lg">Portal de Pagos</a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Cuotas" asp-action="Index" class="btn btn-success btn-lg">Portal de Pagos</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success btn-lg">Portal de Pagos</a>
            }
            <a asp-controller="Home" asp-action="Nosotros" class="btn btn-outline-light btn-lg">Conocé nuestra propuesta</a>
        </div>
    </div>
</div>

<div class="row text-center mb-4">
    <div class="col-6">
        <div class="card p-3">
            <div class="fs-3 fw-bold">@ViewBag.CantidadAlumnos</div>
            <div class="text-muted text-uppercase small">Alumnos</div>
        </div>
    </div>
    <div class="col-6">
        <div class="card p-3">
            <div class="fs-3 fw-bold">50 Años</div>
            <div class="text-muted text-uppercase small">De excelencia</div>
        </div>
    </div>
</div>
@if (User.IsInRole("Admin"))
{
    var pagosRecientes = (List<pagos_administracion_mvc.Models.Pago>)ViewBag.PagosRecientes;
    var comprobantesPendientes = (List<pagos_administracion_mvc.Models.Pago>)ViewBag.ComprobantesPendientes;

    @if (comprobantesPendientes.Any())
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center mb-3">
            <span><i class="bi bi-exclamation-triangle-fill"></i> Tenés <strong>@comprobantesPendientes.Count</strong> comprobante(s) esperando revisión.</span>
            <a asp-controller="Pagos" asp-action="Index" class="btn btn-sm btn-warning">Revisar ahora</a>
        </div>
    }

    <div class="card p-3 mb-4">
        <h6 class="mb-3">Pagos aprobados (últimas 48hs)</h6>
        @if (!pagosRecientes.Any())
        {
            <p class="text-muted small mb-0">Sin pagos aprobados en este período.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var pago in pagosRecientes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>@pago.Cuota.Alumno.Apellido, @pago.Cuota.Alumno.Nombre — Cuota @pago.Cuota.Mes/@pago.Cuota.Anio</span>
                        <span class="text-muted small">@pago.Monto.ToString("C") · @pago.Fecha.ToString("dd/MM HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </div>
}
<h4 class="mb-3">Novedades y Avisos</h4>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 border-start border-success border-4">
            <span class="badge bg-success mb-1 align-self-start">Importante</span>
            <strong>Inscripciones abiertas 2026</strong>
            <p class="text-muted mb-0 small">Ya se encuentra habilitado el portal para la matriculación de alumnos regulares.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-start border-warning border-4">
            <span class="badge bg-warning text-dark mb-1 align-self-start">Calendario</span>
            <strong>Reunión de Padres - Nivel Primario</strong>
            <p class="text-muted mb-0 small">Se convoca a los tutores de 1° a 3° grado para la presentación del nuevo plan de lectura.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-start border-danger border-4">
            <span class="badge bg-danger mb-1 align-self-start">Aviso</span>
            <strong>Feriado Institucional</strong>
            <p class="text-muted mb-0 small">El próximo viernes la institución permanecerá cerrada por desinfección programada.</p>
        </div>
    </div>
</div>

<h4 class="mb-3">Accesos Rápidos</h4>
<div class="row g-3">
    <div class="col-6 col-md-3">
        <a href="#" class="card p-3 text-center text-decoration-none text-muted" title="Próximamente">
            <div class="fs-2">📅</div>
            Calendario Escolar
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="#" class="card p-3 text-center text-decoration-none text-muted" title="Próximamente">
            <div class="fs-2">🍽️</div>
            Menú Comedor
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="#" class="card p-3 text-center text-decoration-none text-muted" title="Próximamente">
            <div class="fs-2">📄</div>
            Certificados Online
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="#" class="card p-3 text-center text-decoration-none text-muted" title="Próximamente">
            <div class="fs-2">💬</div>
            Contacto Docente
        </a>
    </div>
</div>