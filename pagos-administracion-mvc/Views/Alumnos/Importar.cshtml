@model pagos_administracion_mvc.Models.ImportarAlumnosViewModel
@using pagos_administracion_mvc.Models

@{
    ViewData["Title"] = "Importar alumnos";
    var cursos = (List<pagos_administracion_mvc.Models.Curso>)ViewBag.Cursos;
}

<div class="d-flex align-items-center gap-2 mb-1">
    <h1 class="mb-0">Importar alumnos</h1>
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">CSV / XLSX</span>
</div>
<p class="text-muted mb-4">
    Cargá hasta cientos de alumnos en un solo paso. Descargá la plantilla, completá los datos y subí el archivo.
</p>

@* ── Resultados de la importación ────────────────────────────────────────── *@
@if (Model.ProcesadoAlMenosUnaVez)
{
    @if (Model.ImportadosOk > 0 && Model.FilasFallidas == 0 && !Model.Errores.Any(e => e.Contains("advertencia")))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>
                <strong>¡Importación exitosa!</strong>
                Se importaron <strong>@Model.ImportadosOk</strong> alumno@(Model.ImportadosOk == 1 ? "" : "s") correctamente.
            </div>
        </div>
    }
    else if (Model.ImportadosOk > 0)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>
                <strong>Importación parcial.</strong>
                Se importaron <strong>@Model.ImportadosOk</strong> alumno@(Model.ImportadosOk == 1 ? "" : "s") correctamente.
            </div>
        </div>
    }

    @if (Model.Errores.Any())
    {
        @* Separamos advertencias (CursoId inválido) de errores críticos *@
        var advertencias = Model.Errores.Where(e => e.Contains("advertencia")).ToList();
        var erroresCriticos = Model.Errores.Where(e => !e.Contains("advertencia")).ToList();

        if (erroresCriticos.Any())
        {
            <div class="alert alert-warning mb-2" role="alert">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <strong>@erroresCriticos.Count fila@(erroresCriticos.Count == 1 ? "" : "s") no se importaron:</strong>
                </div>
                <ul class="mb-0 ps-3">
                    @foreach (var err in erroresCriticos)
                    {
                        <li class="small">@err</li>
                    }
                </ul>
            </div>
        }

        if (advertencias.Any())
        {
            <div class="alert alert-info mb-2" role="alert">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <strong>Advertencias (@advertencias.Count):</strong>
                </div>
                <ul class="mb-0 ps-3">
                    @foreach (var adv in advertencias)
                    {
                        <li class="small">@adv</li>
                    }
                </ul>
            </div>
        }
    }

    @if (Model.ImportadosOk == 0 && !Model.Errores.Any())
    {
        <div class="alert alert-secondary mb-4" role="alert">
            <i class="bi bi-file-earmark-x me-1"></i>
            El archivo no contenía filas de datos para importar (solo cabecera o estaba vacío).
        </div>
    }
}

@* ── Instrucciones + Pasos ───────────────────────────────────────────────── *@
<div class="row g-4 mb-4">

    @* — Paso 1: Plantilla — *@
    <div class="col-md-5">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="badge rounded-pill bg-primary fs-6 px-3 py-2">1</span>
                    <h5 class="card-title mb-0">Descargá la plantilla</h5>
                </div>
                <p class="text-muted small mb-3">
                    Usá esta plantilla como base. No cambies los nombres de las columnas.
                </p>
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered text-center small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Columna</th>
                                <th>Requerido</th>
                                <th>Valores válidos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td class="fw-semibold">Nombre</td><td><i class="bi bi-check-lg text-success"></i></td><td>Texto</td></tr>
                            <tr><td class="fw-semibold">Apellido</td><td><i class="bi bi-check-lg text-success"></i></td><td>Texto</td></tr>
                            <tr><td class="fw-semibold">Dni</td><td><i class="bi bi-check-lg text-success"></i></td><td>Texto/número único</td></tr>
                            <tr><td class="fw-semibold">Nivel</td><td><i class="bi bi-check-lg text-success"></i></td><td><code>Primaria</code> / <code>Secundaria</code></td></tr>
                            <tr><td class="fw-semibold">GradoAnio</td><td><i class="bi bi-check-lg text-success"></i></td><td>1 a 6</td></tr>
                            <tr><td class="fw-semibold">Turno</td><td><i class="bi bi-check-lg text-success"></i></td><td><code>Mañana</code> / <code>Tarde</code></td></tr>
                            <tr><td class="fw-semibold">EsRecursante</td><td class="text-muted">—</td><td><code>true</code> / <code>false</code></td></tr>
                            <tr><td class="fw-semibold">CursoId</td><td class="text-muted">—</td><td>ID numérico de curso activo</td></tr>
                        </tbody>
                    </table>
                </div>
                @if (cursos != null && cursos.Any())
                {
                    <details class="mb-3">
                        <summary class="small text-muted" style="cursor:pointer;">
                            <i class="bi bi-list-ul me-1"></i> Ver cursos activos y sus IDs
                        </summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm table-striped text-center small mb-0">
                                <thead class="table-light">
                                    <tr><th>ID</th><th>Curso</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var curso in cursos)
                                    {
                                        <tr>
                                            <td><code>@curso.Id</code></td>
                                            <td>@curso.Etiqueta</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
                <a asp-action="DescargarExcelEjemplo"
                   class="btn btn-outline-success w-100"
                   id="btn-descargar-plantilla">
                    <i class="bi bi-file-earmark-excel me-2"></i>Descargar plantilla Excel (.xlsx)
                </a>
            </div>
        </div>
    </div>

    @* — Paso 2: Subir archivo — *@
    <div class="col-md-7">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="badge rounded-pill bg-primary fs-6 px-3 py-2">2</span>
                    <h5 class="card-title mb-0">Subí el archivo completo</h5>
                </div>
                <p class="text-muted small mb-3">
                    Seleccioná tu archivo <strong>.csv</strong> o <strong>.xlsx</strong> con los datos de los alumnos.
                    Las filas con DNIs duplicados serán informadas sin interrumpir el resto de la importación.
                </p>
                <form asp-action="Importar"
                      method="post"
                      enctype="multipart/form-data"
                      id="form-importar">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="archivo" class="form-label fw-semibold">
                            Archivo de alumnos
                        </label>
                        <input type="file"
                               class="form-control"
                               id="archivo"
                               name="archivo"
                               accept=".csv,.xlsx"
                               required />
                        <div class="form-text">
                            Formatos aceptados: <code>.csv</code> o <code>.xlsx</code>. Tamaño máximo recomendado: 5 MB.
                        </div>
                    </div>

                    @* Preview del archivo seleccionado *@
                    <div id="file-preview" class="d-none alert alert-secondary py-2 small mb-3">
                        <i class="bi bi-file-earmark-text me-1"></i>
                        <span id="file-name"></span>
                        <span class="text-muted ms-1" id="file-size"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary btn-lg"
                                id="btn-importar">
                            <span id="btn-importar-idle">
                                <i class="bi bi-upload me-2"></i>Importar alumnos
                            </span>
                            <span id="btn-importar-loading" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Procesando…
                            </span>
                        </button>
                    </div>
                </form>

                @* Consejos rápidos *@
                <hr class="my-4" />
                <h6 class="text-muted small mb-2"><i class="bi bi-lightbulb me-1"></i>Consejos rápidos</h6>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-1"><i class="bi bi-dot"></i>Si un DNI ya existe en el sistema, esa fila <strong>no se importa</strong> pero el resto sí continúa.</li>
                    <li class="mb-1"><i class="bi bi-dot"></i>El campo <code>CursoId</code> es opcional. Si lo dejás vacío, el alumno se importa sin inscripción y la podés asignar después.</li>
                    <li class="mb-1"><i class="bi bi-dot"></i>Podés repetir la importación las veces que quieras; los duplicados siempre se saltan sin problema.</li>
                    <li><i class="bi bi-dot"></i>Los textos con comas internas no son problema: el motor de CSV los detecta y procesa correctamente.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-link px-0">
        <i class="bi bi-arrow-left me-1"></i>Volver a la lista de alumnos
    </a>
</div>

@section Scripts {
    <script>
        // ── Preview del archivo seleccionado ────────────────────────────────
        document.getElementById('archivo').addEventListener('change', function () {
            const file = this.files[0];
            const preview = document.getElementById('file-preview');
            if (file) {
                const sizeMb = (file.size / 1024 / 1024).toFixed(2);
                document.getElementById('file-name').textContent = file.name;
                document.getElementById('file-size').textContent = `(${sizeMb} MB)`;
                preview.classList.remove('d-none');
            } else {
                preview.classList.add('d-none');
            }
        });

        // ── Spinner al enviar ────────────────────────────────────────────────
        document.getElementById('form-importar').addEventListener('submit', function () {
            document.getElementById('btn-importar-idle').classList.add('d-none');
            document.getElementById('btn-importar-loading').classList.remove('d-none');
            document.getElementById('btn-importar').disabled = true;
        });
    </script>
}
