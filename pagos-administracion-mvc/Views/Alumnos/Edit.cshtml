@model pagos_administracion_mvc.Models.Alumno
@using Microsoft.AspNetCore.Mvc.Rendering;

@{
    ViewData["Title"] = "Editar alumno";
}

<h1>Editar alumno</h1>

<div class="card p-4 mb-3" style="max-width: 500px;">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Nombre" class="control-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Apellido" class="control-label"></label>
            <input asp-for="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Dni" class="control-label"></label>
            <input asp-for="Dni" class="form-control" />
            <span asp-validation-for="Dni" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Nivel" class="control-label"></label>
            <select asp-for="Nivel" class="form-control" asp-items="Html.GetEnumSelectList<pagos_administracion_mvc.Models.Enums.NivelEducativo>()"></select>
            <span asp-validation-for="Nivel" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="GradoAnio" class="control-label"></label>
            <input asp-for="GradoAnio" class="form-control" />
            <span asp-validation-for="GradoAnio" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Turno" class="control-label"></label>
            <select asp-for="Turno" class="form-control" asp-items="Html.GetEnumSelectList<pagos_administracion_mvc.Models.Enums.Turno>()"></select>
            <span asp-validation-for="Turno" class="text-danger"></span>
        </div>

        <!-- REEMPLAZO DEL SELECT POR RADIOS CON BUSCADOR -->
        <div class="form-group mb-3">
            <label class="control-label fw-bold">Familia asignada</label>
            <div class="row g-2 mb-2">
                <div class="col">
                    <input type="text" id="filtroFamiliaTexto" class="form-control form-control-sm" placeholder="Buscar por email...">
                </div>
            </div>
            <div id="listaFamiliasRadio" class="border rounded p-2 bg-body" style="max-height: 250px; overflow-y: auto;">
                <div class="form-check familia-item" data-email="">
                    <input class="form-check-input" type="radio" name="FamiliaUserId" value="" id="familia-ninguna" checked="@(Model?.FamiliaUserId == null)" />
                    <label class="form-check-label" for="familia-ninguna"><em>Sin asignar</em></label>
                </div>
                @foreach (SelectListItem item in (SelectList)ViewBag.FamiliaUserId)
                {
                    <div class="form-check familia-item" data-email="@item.Text.ToLower()">
                        <input class="form-check-input" type="radio" name="FamiliaUserId" value="@item.Value" id="familia-@item.Value" checked="@(Model?.FamiliaUserId == item.Value)" />
                        <label class="form-check-label" for="familia-@item.Value">@item.Text</label>
                    </div>
                }
            </div>
            <span asp-validation-for="FamiliaUserId" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </form>
</div>

<div>
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}