@model pagos_administracion_mvc.Models.Alumno
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Dar de baja alumno";
}

<h1>Dar de baja alumno</h1>

@if ((int)ViewBag.CuotasPendientes > 0)
{
    <div class="alert alert-danger">
        <strong>⚠ Tiene @ViewBag.CuotasPendientes cuota(s) con saldo pendiente, por un total de @(((decimal)ViewBag.SaldoPendiente).ToString("C")).</strong>
        <p class="mb-0">Podés dar de baja igual — no se pierde nada, el historial de cuotas y pagos queda intacto y accesible — pero la deuda va a dejar de aparecer en los listados activos.</p>
    </div>
}
else
{
    <div class="alert alert-warning">¿Confirmás que querés dar de baja a este alumno? No se borra su historial de cuotas y pagos, pero deja de aparecer en los listados.</div>
}

<div class="card p-4 mb-3" style="max-width: 500px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre @Model.Apellido</dd>
        <dt class="col-sm-4">DNI</dt>
        <dd class="col-sm-8">@Model.Dni</dd>
        <dt class="col-sm-4">Nivel</dt>
        <dd class="col-sm-8">@Model.Nivel — @Model.GradoAnio° grado/año</dd>
        <dt class="col-sm-4">Turno</dt>
        <dd class="col-sm-8">@Model.Turno</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-warning">Dar de baja</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>