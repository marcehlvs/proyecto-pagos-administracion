@model pagos_administracion_mvc.Models.Alumno

@{
    ViewData["Title"] = "Nuevo alumno";
}

<h1>Nuevo alumno</h1>

<div class="card p-4 mb-3" style="max-width: 500px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Nombre" class="control-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Apellido" class="control-label"></label>
            <input asp-for="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Dni" class="control-label"></label>
            <input asp-for="Dni" class="form-control" />
            <span asp-validation-for="Dni" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Nivel" class="control-label"></label>
            <select asp-for="Nivel" class="form-control" asp-items="Html.GetEnumSelectList<pagos_administracion_mvc.Models.Enums.NivelEducativo>()"></select>
            <span asp-validation-for="Nivel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="GradoAnio" class="control-label"></label>
            <input asp-for="GradoAnio" class="form-control" />
            <span asp-validation-for="GradoAnio" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Turno" class="control-label"></label>
            <select asp-for="Turno" class="form-control" asp-items="Html.GetEnumSelectList<pagos_administracion_mvc.Models.Enums.Turno>()"></select>
            <span asp-validation-for="Turno" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="FamiliaUserId" class="control-label">Familia asignada</label>
            <select asp-for="FamiliaUserId" class="form-control" asp-items="ViewBag.FamiliaUserId">
                <option value="">-- Sin asignar --</option>
            </select>
            <span asp-validation-for="FamiliaUserId" class="text-danger"></span>
        </div>
        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </form>
</div>

<div>
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}