@model pagos_administracion_mvc.Models.Alumno

@{
    ViewData["Title"] = "Detalle de alumno";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Detalle de alumno</h1>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
</div>

<div class="card p-4" style="max-width: 500px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre @Model.Apellido</dd>

        <dt class="col-sm-4">DNI</dt>
        <dd class="col-sm-8">@Model.Dni</dd>

        <dt class="col-sm-4">Nivel</dt>
        <dd class="col-sm-8">@Model.Nivel</dd>

        <dt class="col-sm-4">Grado/Año</dt>
        <dd class="col-sm-8">@Model.GradoAnio°</dd>

        <dt class="col-sm-4">Turno</dt>
        <dd class="col-sm-8">@Model.Turno</dd>

        <dt class="col-sm-4">Familia asignada</dt>
        <dd class="col-sm-8">@(Model.FamiliaUser?.Email ?? "Sin asignar")</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>