@model pagos_administracion_mvc.Models.Alumno

@using static pagos_administracion_mvc.Models.Enums
@{
    ViewData["Title"] = "Detalle de alumno";

    var iniciales = $"{Model.Nombre?.FirstOrDefault()}{Model.Apellido?.FirstOrDefault()}".ToUpper();

    var nivelColor = Model.Nivel switch {
        NivelEducativo.Primaria   => ("var(--bs-primary)",  "rgba(13,110,253,.12)",  "rgba(13,110,253,.3)"),
        NivelEducativo.Secundaria => ("#6610f2",             "rgba(102,16,242,.12)",  "rgba(102,16,242,.3)"),
        _                         => ("var(--bs-secondary)", "var(--bs-secondary-bg-subtle)", "var(--bs-secondary-border-subtle)")
    };

    var turnoIcon = Model.Turno switch {
        Turno.Mañana => "bi-sunrise-fill",
        Turno.Tarde  => "bi-sunset-fill",
        _            => "bi-clock-fill"
    };
}

@if (TempData["EmailError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["EmailError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Encabezado ─────────────────────────────────────────── *@
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Lista
        </a>
        <h1 class="h5 fw-bold mb-0 text-body">Detalle de alumno</h1>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-pencil-fill me-2"></i>Editar
    </a>
</div>

@* ── Layout principal ────────────────────────────────────── *@
<div class="row g-4 align-items-start" style="max-width:860px;">

    @* ── Columna izquierda: perfil ── *@
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">

            @* Avatar *@
            <div class="det-avatar mx-auto mb-3"
                 style="background: linear-gradient(135deg, @nivelColor.Item1, color-mix(in srgb, @nivelColor.Item1 55%, #000 45%));">
                <span>@iniciales</span>
            </div>

            <h2 class="h6 fw-bold mb-0">@Model.Nombre @Model.Apellido</h2>
            <p class="text-muted small mt-1 mb-3 font-monospace">@Model.Dni</p>

            @* Badge nivel *@
            <div>
                <span class="badge rounded-pill px-3 py-2 mb-2"
                      style="font-size:.78rem; background:@nivelColor.Item2; color:@nivelColor.Item1; border:1px solid @nivelColor.Item3;">
                    @Model.Nivel
                </span>
            </div>

            @* Badge turno *@
            <div>
                <span class="badge rounded-pill bg-body-secondary text-body px-3 py-2" style="font-size:.78rem;">
                    <i class="bi @turnoIcon me-1"></i>@Model.Turno
                </span>
            </div>
        </div>
    </div>

    @* ── Columna derecha ── *@
    <div class="col-12 col-md-8 d-flex flex-column gap-4">

        @* Datos académicos *@
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h3 class="h6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing:.06em; font-size:.72rem;">
                <i class="bi bi-mortarboard me-2"></i>Datos académicos
            </h3>
            <div class="row g-3">
                <div class="col-6">
                    <div class="det-info-item">
                        <span class="det-info-label">Nivel</span>
                        <span class="det-info-value">@Model.Nivel</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="det-info-item">
                        <span class="det-info-label">Grado / Año</span>
                        <span class="det-info-value">@Model.GradoAnio°</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="det-info-item">
                        <span class="det-info-label">Turno</span>
                        <span class="det-info-value"><i class="bi @turnoIcon me-1 opacity-75"></i>@Model.Turno</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="det-info-item">
                        <span class="det-info-label">DNI</span>
                        <span class="det-info-value font-monospace">@Model.Dni</span>
                    </div>
                </div>
            </div>
        </div>

        @* Accesos del sistema *@
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h3 class="h6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing:.06em; font-size:.72rem;">
                <i class="bi bi-shield-lock me-2"></i>Accesos del sistema
            </h3>

            @* Familia *@
            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                <div class="det-access-icon" style="background:rgba(255,193,7,.15);">
                    <i class="bi bi-people-fill text-warning"></i>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-semibold small">Familia asignada</div>
                    <div class="text-muted small text-truncate">
                        @(Model.FamiliaUser?.Email ?? "Sin familia asignada")
                    </div>
                </div>
                @if (Model.FamiliaUser != null)
                {
                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2 flex-shrink-0">
                        <i class="bi bi-check-circle-fill me-1"></i>Vinculado
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-2 flex-shrink-0">Sin asignar</span>
                }
            </div>

            @* Alumno *@
            <div class="d-flex align-items-center gap-3">
                <div class="det-access-icon" style="background:rgba(13,110,253,.15);">
                    <i class="bi bi-person-fill text-primary"></i>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-semibold small">Acceso propio (Alumno)</div>
                    <div class="text-muted small text-truncate">
                        @(Model.AlumnoUser != null ? Model.AlumnoUser.Email : "Sin acceso creado")
                    </div>
                </div>
                @if (Model.AlumnoUser != null)
                {
                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2 flex-shrink-0">
                        <i class="bi bi-check-circle-fill me-1"></i>Activo
                    </span>
                }
                else
                {
                    <a asp-action="CrearAcceso" asp-route-id="@Model.Id"
                       class="btn btn-sm btn-primary rounded-pill px-3 flex-shrink-0">
                        <i class="bi bi-plus-lg me-1"></i>Crear acceso
                    </a>
                }
            </div>
        </div>

    </div>
</div>

<style>
    .det-avatar {
        width: 80px; height: 80px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .det-avatar span {
        font-size: 1.6rem; font-weight: 700; color: #fff; letter-spacing: 2px; line-height: 1;
    }
    .det-info-item {
        display: flex; flex-direction: column; gap: 2px;
        padding: .55rem .75rem;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color-translucent);
        border-radius: .6rem;
        transition: background .18s;
    }
    .det-info-item:hover { background: var(--bs-tertiary-bg); }
    .det-info-label {
        font-size: .68rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: .06em;
        color: var(--bs-secondary-color);
    }
    .det-info-value {
        font-size: .92rem; font-weight: 500; color: var(--bs-body-color);
    }
    .det-access-icon {
        width: 40px; height: 40px; border-radius: .6rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; flex-shrink: 0;
    }
</style>