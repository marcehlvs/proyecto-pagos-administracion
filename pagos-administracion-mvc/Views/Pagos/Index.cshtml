@model IEnumerable<pagos_administracion_mvc.Models.Pago>
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small">Alumno</label>
        <select name="alumnoId" class="form-select" asp-items="ViewBag.AlumnoId" onchange="this.form.submit()">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small">Estado</label>
        <select name="estado" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (EstadoPago e in Enum.GetValues(typeof(EstadoPago)))
            {
                <option value="@((int)e)" selected="@(ViewBag.EstadoSeleccionado == e)">@e</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar filtros</a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CuotaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cuota)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Monto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MercadoPagoPaymentId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MercadoPagoPreferenceId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CuotaId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cuota)
            </td>
            <td>
                @Html.DisplayFor(model => item.Monto)
            </td>
            <td>
                @Html.DisplayFor(model => item.Fecha)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.MercadoPagoPaymentId)
            </td>
            <td>
                @Html.DisplayFor(model => item.MercadoPagoPreferenceId)
            </td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Ver</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Eliminar</a>
                    </div>
                </td>
        </tr>
}
    </tbody>
</table>
