@model IEnumerable<pagos_administracion_mvc.Models.Pago>
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Pagos";
}

<h1>Pagos</h1>
<p><a asp-action="Create" class="btn btn-primary btn-sm">+ Nuevo pago</a></p>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small">Buscar alumno</label>
        <input type="text" name="buscarAlumno" class="form-control" placeholder="Apellido, nombre o DNI" value="@ViewBag.BuscarAlumno" />
    </div>
    <div class="col-auto">
        <label class="form-label small">Estado</label>
        <select name="estado" class="form-select">
            <option value="">Todos</option>
            @foreach (EstadoPago e in Enum.GetValues(typeof(EstadoPago)))
            {
                <option value="@((int)e)" selected="@(ViewBag.EstadoSeleccionado == e)">@e</option>
            }
        </select>
    </div>

    <!-- NUEVOS FILTROS -->
    <div class="col-auto">
        <label class="form-label small">Nivel</label>
        <select name="nivel" class="form-select">
            <option value="">Todos</option>
            @foreach (NivelEducativo n in Enum.GetValues(typeof(NivelEducativo)))
            {
                <option value="@((int)n)" selected="@(ViewBag.NivelSeleccionado == n)">@n</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small">Grado/Año</label>
        <input type="number" name="gradoAnio" class="form-control" value="@ViewBag.GradoSeleccionado" style="width: 90px;" />
    </div>
    <div class="col-auto">
        <label class="form-label small">Turno</label>
        <select name="turno" class="form-select">
            <option value="">Todos</option>
            @foreach (Turno t in Enum.GetValues(typeof(Turno)))
            {
                <option value="@((int)t)" selected="@(ViewBag.TurnoSeleccionado == t)">@t</option>
            }
        </select>
    </div>
    <!-- FIN NUEVOS FILTROS -->

    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar filtros</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Alumno</th>
            <th>Cuota</th>
            <th>Monto</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">@item.Cuota.Alumno.Apellido, @item.Cuota.Alumno.Nombre</td>
                <td class="align-middle">@item.Cuota.Mes/@item.Cuota.Anio</td>
                <td class="align-middle">@item.Monto.ToString("C")</td>
                <td class="align-middle">@item.Fecha.ToString("dd/MM/yyyy")</td>
                <td class="align-middle">
                    @if (item.Estado == EstadoPago.EnRevision)
                    {
                        <span class="badge bg-warning text-dark">En Revisión</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Estado</span>
                    }
                </td>
                <td class="align-middle text-end">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Acciones
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye"></i> Ver detalle
                                </a>
                            </li>
                            @if (!string.IsNullOrEmpty(item.ComprobanteRuta))
                            {
                                <li>
                                    <a class="dropdown-item text-info" asp-action="VerComprobante" asp-route-pagoId="@item.Id" target="_blank">
                                        <i class="bi bi-file-earmark-text"></i> Ver comprobante
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                            </li>

                            @if (item.Estado == EstadoPago.EnRevision)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-action="AprobarComprobante" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="dropdown-item text-success fw-bold">
                                            <i class="bi bi-check-circle"></i> Aprobar
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-action="RechazarComprobante" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="dropdown-item text-danger fw-bold">
                                            <i class="bi bi-x-circle"></i> Rechazar
                                        </button>
                                    </form>
                                </li>
                            }

                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>