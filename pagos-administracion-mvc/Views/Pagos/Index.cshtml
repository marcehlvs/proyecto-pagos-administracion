@model IEnumerable<pagos_administracion_mvc.Models.Pago>
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Pagos";
}

<h1>Pagos</h1>
<p><a asp-action="Create" class="btn btn-primary btn-sm">+ Nuevo pago</a></p>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small">Buscar alumno</label>
        <input type="text" name="buscarAlumno" class="form-control" placeholder="Apellido, nombre o DNI" value="@ViewBag.BuscarAlumno" />
    </div>
    <div class="col-auto">
        <label class="form-label small">Estado</label>
        <select name="estado" class="form-select">
            <option value="">Todos</option>
            @foreach (EstadoPago e in Enum.GetValues(typeof(EstadoPago)))
            {
                <option value="@((int)e)" selected="@(ViewBag.EstadoSeleccionado == e)">@e</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Buscar</button></div>
    <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar filtros</a></div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Alumno</th>
            <th>Cuota</th>
            <th>Monto</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Cuota.Alumno.Apellido, @item.Cuota.Alumno.Nombre</td>
                <td>@item.Cuota.Mes/@item.Cuota.Anio</td>
                <td>@item.Monto.ToString("C")</td>
                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@item.Estado</td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Ver</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>