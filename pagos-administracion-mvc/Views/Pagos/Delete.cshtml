@model pagos_administracion_mvc.Models.Pago

@{
    ViewData["Title"] = "Eliminar pago";
}

<h1>Eliminar pago</h1>

<div class="alert alert-danger">
    ¿Confirmás que querés eliminar este pago? Esta acción no se puede deshacer.
</div>

<div class="card p-4 mb-3" style="max-width: 500px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Cuota</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.CuotaId)</dd>

        <dt class="col-sm-4">Monto</dt>
        <dd class="col-sm-8">$@Model.Monto</dd>

        <dt class="col-sm-4">Fecha</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Fecha)</dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">@Model.Estado</dd>

        @if (!string.IsNullOrEmpty(Model.MercadoPagoPaymentId))
        {
            <dt class="col-sm-4">ID MercadoPago</dt>
            <dd class="col-sm-8">@Model.MercadoPagoPaymentId</dd>
        }
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>