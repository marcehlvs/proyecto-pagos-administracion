@model pagos_administracion_mvc.Models.Cuota
@{
    ViewData["Title"] = "Registrar pago manual";
}

<h1>Registrar pago manual</h1>
<p class="text-muted">@Model.Alumno.Apellido, @Model.Alumno.Nombre — Cuota @Model.Mes/@Model.Anio</p>

<div class="card p-4" style="max-width: 500px;">
    <form asp-action="RegistrarManual" method="post" enctype="multipart/form-data">
        <input type="hidden" name="cuotaId" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Monto recibido</label>
            <input type="number" step="0.01" name="monto" class="form-control" value="@Model.MontoAPagar" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Fecha del pago</label>
            <input type="date" name="fecha" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Comprobante (opcional — foto de WhatsApp, etc.)</label>
            <input type="file" name="comprobante" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
        </div>

        <button type="submit" class="btn btn-success">Registrar pago</button>
        <a asp-controller="Cuotas" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancelar</a>
    </form>
</div>