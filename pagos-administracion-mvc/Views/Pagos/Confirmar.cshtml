@model pagos_administracion_mvc.Models.Cuota
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Confirmar pago";

    string[] meses = { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };

    var esVencida = Model.Estado == EstadoCuota.Vencida;
}

@if (TempData["ErrorComprobante"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorComprobante"]</div>
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5">

        <div class="card p-4 mb-3 shadow-sm">
            @if (esVencida)
            {
                <span class="badge bg-danger align-self-start mb-2">Cuota vencida</span>
            }
            <h5 class="mb-1">@meses[Model.Mes] @Model.Anio</h5>
            <p class="text-muted small mb-2">@Model.Alumno.Apellido, @Model.Alumno.Nombre</p>

            <div class="d-flex justify-content-between border-top pt-2 mt-1">
                <span class="text-muted">@(Model.Estado == EstadoCuota.Parcial ? "Saldo pendiente" : "Total a pagar")</span>
                <div class="text-end">
                    @if (Model.Estado == EstadoCuota.Parcial)
                    {
                        <span class="fw-bold fs-4">@Model.SaldoPendiente.ToString("C")</span>
                        <div class="small text-muted">Ya pagaste @Model.TotalPagado.ToString("C") de @Model.Monto.ToString("C")</div>
                    }
                    else if (Model.MontoConDescuento.HasValue && Model.FechaLimiteDescuento.HasValue && DateTime.Today <= Model.FechaLimiteDescuento.Value)
                    {
                        <span class="text-muted text-decoration-line-through me-2">@Model.Monto.ToString("C")</span>
                        <span class="fw-bold fs-4 text-success">@Model.MontoConDescuento.Value.ToString("C")</span>
                        <div class="small text-muted">Precio válido pagando antes del @Model.FechaLimiteDescuento.Value.ToString("dd/MM")</div>
                    }
                    else
                    {
                        <span class="fw-bold fs-4">@Model.Monto.ToString("C")</span>
                    }
                </div>
            </div>

        <ul class="nav nav-tabs" id="metodoPagoTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-mp" type="button">Mercado Pago</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-transferencia" type="button">Transferencia bancaria</button>
            </li>
        </ul>

        <div class="tab-content card border-top-0 rounded-top-0 p-4 shadow-sm">

            <div class="tab-pane fade show active" id="tab-mp">
                <p class="text-muted small">Pagá al instante con tarjeta, dinero en cuenta o medios habilitados por Mercado Pago.</p>
                <form asp-controller="Pagos" asp-action="Pagar" method="post">
                    <input type="hidden" name="cuotaId" value="@Model.Id" />
                    <button type="submit" class="btn btn-success w-100 py-2">Pagar con Mercado Pago</button>
                </form>
            </div>

            <div class="tab-pane fade" id="tab-transferencia">
                <p class="text-muted small">Transferí el monto exacto y subí el comprobante para confirmación manual.</p>

                <div class="bg-light rounded p-3 mb-3 border">
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">Alias</span><strong>@ViewBag.Alias</strong></div>
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">CBU</span><strong>@ViewBag.Cbu</strong></div>
                    <div class="d-flex justify-content-between py-1"><span class="text-muted small">Titular</span><strong>@ViewBag.Titular</strong></div>
                </div>

                <form asp-controller="Pagos" asp-action="SubirComprobante" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="cuotaId" value="@Model.Id" />
                    <label class="form-label small">Comprobante (.jpg, .png o .pdf)</label>
                    <input type="file" name="archivo" class="form-control mb-3" accept=".jpg,.jpeg,.png,.pdf" required />
                    <button type="submit" class="btn btn-outline-primary w-100">Subir comprobante</button>
                </form>
            </div>

        </div>

        <div class="text-center mt-3">
            <a asp-controller="MisCuotas" asp-action="Index" class="btn btn-link btn-sm text-decoration-none">← Volver a mis cuotas</a>
        </div>
    </div>
</div>