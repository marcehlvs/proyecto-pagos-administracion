@model List<pagos_administracion_mvc.Models.Inscripcion>
@using static pagos_administracion_mvc.Models.Enums
@using pagos_administracion_mvc.Services

@{
    ViewData["Title"] = "Mis Asistencias";
    var vista = (string)ViewBag.Vista;
    var inicio = (DateTime?)ViewBag.Inicio;
    var fin = (DateTime?)ViewBag.Fin;
    var fechaPrev = (DateTime)ViewBag.FechaPrev;
    var fechaNext = (DateTime)ViewBag.FechaNext;
    var tituloPeriodo = (string)ViewBag.TituloPeriodo;

    string ClaseTab(string v) => vista == v ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
}

<h1>Mis Asistencias</h1>
<p class="text-muted">Se muestran solo tus llegadas tarde y ausencias. Los días sin novedades no aparecen listados.</p>

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <div class="btn-group" role="group">
        <a class="@ClaseTab("semana")" asp-action="Index" asp-route-vista="semana" asp-route-fecha="@DateTime.Today.ToString("yyyy-MM-dd")">Semana</a>
        <a class="@ClaseTab("mes")" asp-action="Index" asp-route-vista="mes" asp-route-fecha="@DateTime.Today.ToString("yyyy-MM-dd")">Mes</a>
        <a class="@ClaseTab("todo")" asp-action="Index" asp-route-vista="todo">Todo</a>
    </div>

    @if (vista != "todo")
    {
        <div class="btn-group ms-2" role="group">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-vista="@vista" asp-route-fecha="@fechaPrev.ToString("yyyy-MM-dd")">‹ Anterior</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-vista="@vista" asp-route-fecha="@fechaNext.ToString("yyyy-MM-dd")">Siguiente ›</a>
        </div>
        <strong class="ms-2 text-capitalize">@tituloPeriodo</strong>
    }
    else
    {
        <strong class="ms-2">@tituloPeriodo</strong>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no estás inscripto en ningún curso.</p>
}

@foreach (var inscripcion in Model)
{
    var curso = inscripcion.Curso;

    // Asistencias dentro del período elegido (semana/mes) o todas, si vista == "todo".
    var asistenciasDelPeriodo = inscripcion.Asistencias
        .Where(a => (inicio == null || a.Fecha >= inicio) && (fin == null || a.Fecha <= fin))
        .ToList();

    var presentismoPeriodo = AsistenciaCalculadora.CalcularPresentismo(asistenciasDelPeriodo, curso);
    var faltasPeriodo = AsistenciaCalculadora.CalcularTotalFaltas(asistenciasDelPeriodo, curso);

    // Agrupa por día para poder calcular la fracción de falta total de cada jornada, aunque
    // solo se muestren los días con Tarde o Ausente (nunca los Presente).
    var porDia = asistenciasDelPeriodo
        .GroupBy(a => a.Fecha)
        .Select(g =>
        {
            var diaTieneEF = curso.TieneEducacionFisica(g.Key);
            var fraccion = g.Sum(a => AsistenciaCalculadora.CalcularFraccionFalta(a.Materia, a.Estado, diaTieneEF));
            var registrosVisibles = g.Where(a => a.Estado == EstadoAsistencia.Ausente || a.Estado == EstadoAsistencia.Tarde).ToList();
            return new { Fecha = g.Key, Fraccion = fraccion, Registros = registrosVisibles };
        })
        .Where(d => d.Registros.Any())
        .OrderByDescending(d => d.Fecha)
        .ToList();

    var totalFaltasHistorico = AsistenciaCalculadora.CalcularTotalFaltas(inscripcion.Asistencias, curso);
    var promediosPorCurso = (Dictionary<int, decimal>)ViewBag.PromedioPorCurso;
    var promedioCurso = promediosPorCurso.TryGetValue(curso.Id, out var p) ? p : 0m;

    var colorPresentismo = presentismoPeriodo >= 90 ? "bg-success" : presentismoPeriodo >= 75 ? "bg-warning text-dark" : "bg-danger";

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@curso.Etiqueta</strong>
            <span class="text-muted small">@curso.Nivel — @curso.GradoAnio° grado/año — Turno @curso.Turno</span>
        </div>
        <div class="card-body">
            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                <span class="badge @colorPresentismo fs-6">Presentismo del período: @presentismoPeriodo.ToString("0.#")%</span>
                <span class="badge bg-danger">Faltas del período: @faltasPeriodo.ToString("0.##")</span>
                <span class="badge bg-secondary">Total histórico: @totalFaltasHistorico.ToString("0.##") falta@(totalFaltasHistorico == 1 ? "" : "s")</span>
                <span class="badge bg-secondary">Promedio del curso (histórico): @promedioCurso.ToString("0.##")</span>
            </div>

            @if (porDia.Any())
            {
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Detalle</th>
                            <th class="text-center">Falta del día</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dia in porDia)
                        {
                            <tr>
                                <td class="align-middle">@dia.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="align-middle">
                                    @foreach (var r in dia.Registros)
                                    {
                                        var claseBadge = r.Estado == EstadoAsistencia.Ausente ? "bg-danger" : "bg-warning text-dark";
                                        var etiquetaMateria = r.Materia == Materia.EducacionFisica ? "Ed. Física" : "Clase";
                                        <span class="badge @claseBadge me-1">@etiquetaMateria: @r.Estado</span>
                                    }
                                </td>
                                <td class="text-center align-middle">@dia.Fraccion.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">Sin ausencias ni llegadas tarde en este período. ¡Todo en orden!</p>
            }
        </div>
    </div>
}
