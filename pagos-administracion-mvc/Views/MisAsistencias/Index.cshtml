@model List<pagos_administracion_mvc.Models.Inscripcion>
@using static pagos_administracion_mvc.Models.Enums
@using pagos_administracion_mvc.Services

@{
    ViewData["Title"] = "Mis Asistencias";
}

<h1>Mis Asistencias</h1>
<p class="text-muted">Se muestran solo tus llegadas tarde y ausencias. Los días sin novedades no aparecen listados.</p>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no estás inscripto en ningún curso.</p>
}

@foreach (var inscripcion in Model)
{
    var curso = inscripcion.Curso;

    // Agrupa las asistencias (Clase + Educación Física) por día para poder calcular
    // la fracción de falta total de cada jornada, aunque solo se muestren los días
    // con Tarde o Ausente (nunca los Presente).
    var porDia = inscripcion.Asistencias
        .GroupBy(a => a.Fecha)
        .Select(g =>
        {
            var diaTieneEF = curso.TieneEducacionFisica(g.Key);
            var fraccion = g.Sum(a => AsistenciaCalculadora.CalcularFraccionFalta(a.Materia, a.Estado, diaTieneEF));
            var registrosVisibles = g.Where(a => a.Estado == EstadoAsistencia.Ausente || a.Estado == EstadoAsistencia.Tarde).ToList();
            return new { Fecha = g.Key, Fraccion = fraccion, Registros = registrosVisibles };
        })
        .Where(d => d.Registros.Any())
        .OrderByDescending(d => d.Fecha)
        .ToList();

    var totalFaltas = porDia.Sum(d => d.Fraccion);

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@curso.Nombre</strong>
            <span class="text-muted small">@curso.Nivel — @curso.GradoAnio° grado/año — Turno @curso.Turno</span>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <span class="badge bg-danger">Total acumulado: @totalFaltas.ToString("0.##") falta@(totalFaltas == 1 ? "" : "s")</span>
            </div>

            @if (porDia.Any())
            {
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Detalle</th>
                            <th class="text-center">Falta del día</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dia in porDia)
                        {
                            <tr>
                                <td class="align-middle">@dia.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="align-middle">
                                    @foreach (var r in dia.Registros)
                                    {
                                        var claseBadge = r.Estado == EstadoAsistencia.Ausente ? "bg-danger" : "bg-warning text-dark";
                                        var etiquetaMateria = r.Materia == Materia.EducacionFisica ? "Ed. Física" : "Clase";
                                        <span class="badge @claseBadge me-1">@etiquetaMateria: @r.Estado</span>
                                    }
                                </td>
                                <td class="text-center align-middle">@dia.Fraccion.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">Sin ausencias ni llegadas tarde registradas. ¡Todo en orden!</p>
            }
        </div>
    </div>
}
