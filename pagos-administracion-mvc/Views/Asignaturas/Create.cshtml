@model pagos_administracion_mvc.Models.Asignatura
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Nueva materia";
}

<h1>Nueva materia</h1>

<div class="card p-4" style="max-width: 500px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Matemática, Lengua..." />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nivel" class="form-label"></label>
            <select asp-for="Nivel" class="form-select" asp-items="Html.GetEnumSelectList<NivelEducativo>()"></select>
            <div class="form-text">Si la materia se dicta en los dos niveles, cargala dos veces (una por Nivel).</div>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
