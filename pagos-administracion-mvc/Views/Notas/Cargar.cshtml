@model pagos_administracion_mvc.Models.CargarNotasViewModel
@{
    ViewData["Title"] = "Cargar notas";
    var ca = Model.CursoAsignatura;

    // Notas de 0 a 10 de a 0.5 (0, 0.5, 1, 1.5, ..., 10): se carga desde un <select> en vez de
    // un <input type="number"> para no permitir valores como 7.23 que no tienen sentido en la
    // escala de la escuela.
    var pasosDeNota = new List<decimal>();
    for (var v = 0m; v <= 10m; v += 0.5m) pasosDeNota.Add(v);
}

<h1>@(Model.SoloLectura ? "Notas (solo lectura)" : "Cargar notas")</h1>
<p class="text-muted">@ca.Curso.Etiqueta — @ca.Asignatura.Nombre</p>

@if (Model.SoloLectura)
{
    <div class="alert alert-secondary">Estás viendo esta materia como Admin: podés ver las notas, pero solo el Docente asignado puede cargarlas o modificarlas.</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<!-- Se anula el límite de 600px -->
<form method="get" asp-action="Cargar" class="row g-2 mb-3 align-items-end" style="max-width: none;">
    <input type="hidden" name="cursoAsignaturaId" value="@ca.Id" />
    <div class="col-auto">
        <label class="form-label small">Período</label>
        <select name="periodoId" class="form-select" onchange="this.form.submit()">
            <option value="">Seleccioná un período...</option>
            @foreach (var p in Model.PeriodosDisponibles)
            {
                <option value="@p.Id" selected="@(Model.PeriodoSeleccionado?.Id == p.Id)">@p.Nombre (@p.Tipo)</option>
            }
        </select>
    </div>
</form>

@if (Model.PeriodoSeleccionado != null)
{
    @if (Model.EsPeriodoContenedor)
    {
        <div class="alert alert-info">
            "@Model.PeriodoSeleccionado.Nombre" agrupa otros períodos (@string.Join(", ", Model.PeriodoSeleccionado.Subperiodos.Select(s => s.Nombre))): su nota sale de promediarlos. Si cargás un valor a mano, ese valor gana y deja de recalcularse — usá "Volver a automático" para deshacerlo.
            @if (Model.MostrarValoracionPreliminar)
            {
                <text> Además, como es un Cuatrimestre, podés cargar la Valoración Preliminar (TEA/TEP/TED) para el boletín RITE.</text>
            }
            @if (Model.MostrarIntensificacion)
            {
                <text> Además, como es el período Anual, podés cargar Intensificación de diciembre y febrero para el boletín RITE.</text>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Cargá tantas notas sueltas quieras para "@Model.PeriodoSeleccionado.Nombre" (mínimo 4, sumá más columnas si necesitás). El promedio se calcula solo — si querés forzar la nota final en vez de promediar, usá la columna "Forzar nota final".
            @if (Model.MostrarValoracionPreliminar)
            {
                <text> Además, como es un Cuatrimestre, podés cargar la Valoración Preliminar (TEA/TEP/TED) para el boletín RITE.</text>
            }
            @if (Model.MostrarIntensificacion)
            {
                <text> Además, como es el período Anual, podés cargar Intensificación de diciembre y febrero para el boletín RITE.</text>
            }
        </div>
    }

    <!-- Se anula el límite de 600px para permitir que la tabla se expanda -->
    <form asp-action="Guardar" method="post" style="max-width: none;">
        <input type="hidden" name="cursoAsignaturaId" value="@ca.Id" />
        <input type="hidden" name="periodoId" value="@Model.PeriodoSeleccionado.Id" />

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Alumno</th>
                        @if (!Model.EsPeriodoContenedor)
                        {
                            @for (var i = 1; i <= Model.Columnas; i++)
                            {
                                <!-- Se incrementa el ancho para los inputs numéricos -->
                                <th style="width: 120px;">Nota @i</th>
                            }
                        }
                        <th style="width: 110px;">Promedio</th>
                        <!-- Se incrementa el ancho de Forzar nota -->
                        <th style="width: 150px;">Forzar nota final</th>
                        @if (Model.MostrarValoracionPreliminar)
                        {
                            <th style="width: 130px;">Valoración preliminar</th>
                        }
                        @if (Model.MostrarIntensificacion)
                        {
                            <th style="width: 120px;">Intensif. diciembre</th>
                            <th style="width: 120px;">Intensif. febrero</th>
                        }
                        <th>Origen</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxSuelta = 0; var idxManual = 0;
                    }
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            <td>@fila.AlumnoNombre</td>

                            @if (!Model.EsPeriodoContenedor)
                            {
                                @for (var i = 1; i <= Model.Columnas; i++)
                                {
                                    var valorActual = fila.ValoresPorOrden.GetValueOrDefault(i);
                                    <td>
                                        <input type="hidden" name="notasSueltas[@idxSuelta].InscripcionId" value="@fila.InscripcionId" />
                                        <input type="hidden" name="notasSueltas[@idxSuelta].Orden" value="@i" />
                                        <select class="form-select form-select-sm text-center"
                                                name="notasSueltas[@idxSuelta].Valor"
                                                disabled="@Model.SoloLectura">
                                            <option value="">—</option>
                                            @foreach (var v in pasosDeNota)
                                            {
                                                <option value="@v.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(valorActual == v)">@v.ToString("0.0")</option>
                                            }
                                        </select>
                                    </td>
                                    idxSuelta++;
                                }
                            }

                            <td class="fw-bold text-center">@(fila.Promedio?.ToString("0.##") ?? "-")</td>

                            @{
                                var valorManualActual = fila.EsPromedioAutomatico ? null : fila.Promedio;
                                var indiceManual = idxManual;
                                idxManual++;
                            }
                            <td>
                                <input type="hidden" name="notaManual[@indiceManual].InscripcionId" value="@fila.InscripcionId" />
                                <select class="form-select form-select-sm text-center"
                                        name="notaManual[@indiceManual].Valor"
                                        disabled="@Model.SoloLectura">
                                    <option value="">Opcional</option>
                                    @foreach (var v in pasosDeNota)
                                    {
                                        <option value="@v.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(valorManualActual == v)">@v.ToString("0.0")</option>
                                    }
                                </select>
                            </td>

                            @if (Model.MostrarValoracionPreliminar)
                            {
                                <td>
                                    <select class="form-select form-select-sm text-center"
                                            name="notaManual[@indiceManual].ValoracionPreliminar"
                                            disabled="@Model.SoloLectura">
                                        <option value="" selected="@(fila.ValoracionPreliminar == null)">—</option>
                                        @foreach (var vp in Enum.GetValues<pagos_administracion_mvc.Models.Enums.ValoracionPreliminar>())
                                        {
                                            <option value="@vp" selected="@(fila.ValoracionPreliminar == vp)">@vp</option>
                                        }
                                    </select>
                                </td>
                            }

                            @if (Model.MostrarIntensificacion)
                            {
                                <td>
                                    <select class="form-select form-select-sm text-center"
                                            name="notaManual[@indiceManual].IntensificacionDiciembre"
                                            disabled="@Model.SoloLectura">
                                        <option value="">—</option>
                                        @foreach (var v in pasosDeNota)
                                        {
                                            <option value="@v.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(fila.IntensificacionDiciembre == v)">@v.ToString("0.0")</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm text-center"
                                            name="notaManual[@indiceManual].IntensificacionFebrero"
                                            disabled="@Model.SoloLectura">
                                        <option value="">—</option>
                                        @foreach (var v in pasosDeNota)
                                        {
                                            <option value="@v.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(fila.IntensificacionFebrero == v)">@v.ToString("0.0")</option>
                                        }
                                    </select>
                                </td>
                            }

                            <td>
                                @if (fila.Promedio == null)
                                {
                                    <span class="text-muted small">Sin notas</span>
                                }
                                else if (fila.EsPromedioAutomatico)
                                {
                                    <span class="badge bg-secondary">Automático</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark me-1">Manual</span>
                                    @if (!Model.SoloLectura)
                                    {
                                        <button type="submit" formaction="@Url.Action("Recalcular")" formnovalidate
                                                name="inscripcionId" value="@fila.InscripcionId"
                                                class="btn btn-link btn-sm p-0 align-baseline">
                                            Volver a automático
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Filas.Any())
                    {
                        <tr><td colspan="10" class="text-muted">Este curso todavía no tiene alumnos inscriptos.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.SoloLectura)
        {
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Guardar notas</button>
                @if (!Model.EsPeriodoContenedor)
                {
                    <a asp-action="Cargar" asp-route-cursoAsignaturaId="@ca.Id" asp-route-periodoId="@Model.PeriodoSeleccionado.Id" asp-route-columnas="@(Model.Columnas + 2)" class="btn btn-outline-secondary">+ Agregar más columnas de nota</a>
                }
            </div>
        }
    </form>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-link px-0">Volver a mis materias</a>
</div>