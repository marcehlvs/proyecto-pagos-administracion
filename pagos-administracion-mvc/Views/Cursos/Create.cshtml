@model pagos_administracion_mvc.Models.Curso
@using Microsoft.AspNetCore.Mvc.Rendering
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Nuevo curso";
    var buscado = (bool)ViewBag.Buscado;
    var diasSeleccionados = (List<int>)ViewBag.DiasEFSeleccionados;
}

<h1>Nuevo curso</h1>

<div class="card p-4 mb-3" style="max-width: 600px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Nivel" class="control-label"></label>
            <select asp-for="Nivel" class="form-control" asp-items="Html.GetEnumSelectList<NivelEducativo>()"></select>
            <span asp-validation-for="Nivel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="GradoAnio" class="control-label"></label>
            <input asp-for="GradoAnio" class="form-control" />
            <span asp-validation-for="GradoAnio" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Turno" class="control-label"></label>
            <select asp-for="Turno" class="form-control" asp-items="Html.GetEnumSelectList<Turno>()"></select>
            <span asp-validation-for="Turno" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Nombre" class="control-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. &quot;Proyecto&quot;, &quot;Sección A&quot; (si lo dejás vacío, se arma con Nivel + Grado/Año + Turno)" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="control-label fw-bold">Días de Educación Física</label>
            <div class="form-text mb-1">Dejá sin marcar si este curso no tiene Educación Física.</div>
            @foreach (DiasSemana dia in new[] { DiasSemana.Lunes, DiasSemana.Martes, DiasSemana.Miercoles, DiasSemana.Jueves, DiasSemana.Viernes, DiasSemana.Sabado })
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="diasEF" value="@((int)dia)" id="dia-@dia" checked="@diasSeleccionados.Contains((int)dia)" />
                    <label class="form-check-label" for="dia-@dia">@dia</label>
                </div>
            }
        </div>

        <div class="form-group mb-3">
            <label asp-for="ProfesorUserId" class="control-label">Docente a cargo</label>
            <select name="ProfesorUserId" class="form-control" asp-items="(SelectList)ViewBag.ProfesorUserId">
                <option value="">Sin asignar</option>
            </select>
        </div>

        <hr class="my-3" />

        <div class="form-group mb-3">
            <button type="submit" formmethod="get" formaction="@Url.Action("Create")" class="btn btn-outline-secondary btn-sm">
                🔍 Buscar alumnos que coincidan con Nivel + Grado/Año + Turno
            </button>
        </div>

        @if (buscado)
        {
            var coincidentes = (List<pagos_administracion_mvc.Models.Alumno>)ViewBag.AlumnosCoincidentes;
            var seleccionados = (List<int>)ViewBag.AlumnosSeleccionados;

            <div class="mb-3">
                <label class="control-label fw-bold">Alumnos que coinciden (@coincidentes.Count)</label>
                @if (coincidentes.Any())
                {
                    <div class="form-text mb-1">Tildados por default. Destildá los que no correspondan matricular en este curso (por ejemplo, si ya tenés otro curso con la misma combinación de Nivel/Grado/Turno).</div>
                    <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                        @foreach (var a in coincidentes)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="alumnosAMatricular" value="@a.Id" id="alumno-@a.Id" checked="@seleccionados.Contains(a.Id)" />
                                <label class="form-check-label" for="alumno-@a.Id">@a.Apellido, @a.Nombre — DNI @a.Dni</label>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No hay alumnos cargados con esa combinación de Nivel + Grado/Año + Turno todavía. Podés matricularlos después desde el detalle del curso.</p>
                }
            </div>
        }

        <div class="form-group mt-3">
            <button type="submit" formmethod="post" formaction="@Url.Action("Create")" class="btn btn-primary">Guardar curso</button>
        </div>
    </form>
</div>

<div>
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
