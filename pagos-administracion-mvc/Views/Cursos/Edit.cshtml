@model pagos_administracion_mvc.Models.Curso
@using Microsoft.AspNetCore.Mvc.Rendering
@using static pagos_administracion_mvc.Models.Enums

@{
    ViewData["Title"] = "Editar curso";
}

<h1>Editar curso</h1>

<div class="card p-4 mb-3" style="max-width: 500px;">
    <form asp-action="Edit" asp-route-id="@Model.Id">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Nombre" class="control-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Nivel" class="control-label"></label>
            <select asp-for="Nivel" class="form-control" asp-items="Html.GetEnumSelectList<NivelEducativo>()"></select>
            <span asp-validation-for="Nivel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="GradoAnio" class="control-label"></label>
            <input asp-for="GradoAnio" class="form-control" />
            <span asp-validation-for="GradoAnio" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Turno" class="control-label"></label>
            <select asp-for="Turno" class="form-control" asp-items="Html.GetEnumSelectList<Turno>()"></select>
            <span asp-validation-for="Turno" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="control-label fw-bold">Días de Educación Física</label>
            <div class="form-text mb-1">Dejá sin marcar si este curso no tiene Educación Física.</div>
            @foreach (DiasSemana dia in new[] { DiasSemana.Lunes, DiasSemana.Martes, DiasSemana.Miercoles, DiasSemana.Jueves, DiasSemana.Viernes, DiasSemana.Sabado })
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="diasEF" value="@((int)dia)" id="dia-@dia" checked="@Model.DiasEducacionFisica.HasFlag(dia)" />
                    <label class="form-check-label" for="dia-@dia">@dia</label>
                </div>
            }
        </div>

        <div class="form-group mb-3">
            <label asp-for="ProfesorUserId" class="control-label">Docente a cargo</label>
            <select name="ProfesorUserId" class="form-control" asp-items="(SelectList)ViewBag.ProfesorUserId">
                <option value="">Sin asignar</option>
            </select>
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </form>
</div>

<div>
    <a asp-action="Index" class="btn btn-link px-0">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
