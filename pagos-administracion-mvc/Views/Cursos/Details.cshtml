@model pagos_administracion_mvc.Models.Curso
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Detalle del curso";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Encabezado ── *@
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Lista
        </a>
        <div>
            <h1 class="h5 fw-bold mb-0 text-body">@Model.Etiqueta</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Nombre))
            {
                <span class="text-muted small">@Model.Nivel — @Model.GradoAnio° año — Turno @Model.Turno</span>
            }
        </div>
    </div>
    <a asp-controller="Asistencias" asp-action="Tomar" asp-route-cursoId="@Model.Id"
       class="btn btn-success rounded-pill px-4">
        <i class="bi bi-clipboard-check me-2"></i>Tomar asistencia
    </a>
</div>

<div class="row g-4">

    @* ══ ALUMNOS ══ *@
    <div class="col-12 col-lg-7">

        @* Tabla de alumnos inscriptos *@
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h6 fw-semibold text-muted text-uppercase mb-0" style="letter-spacing:.06em;font-size:.72rem;">
                    <i class="bi bi-people me-2"></i>Alumnos inscriptos
                </h2>
                <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@Model.Inscripciones.Count</span>
            </div>
            @if (!Model.Inscripciones.Any())
            {
                <div class="text-muted small fst-italic py-2">Todavía no hay alumnos inscriptos.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold small">Alumno</th>
                                <th class="fw-semibold small">DNI</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Inscripciones.OrderBy(i => i.Alumno.Apellido))
                            {
                                <tr>
                                    <td class="small fw-semibold">@i.Alumno.Apellido, @i.Alumno.Nombre</td>
                                    <td class="small text-muted font-monospace">@i.Alumno.Dni</td>
                                    <td class="text-end">
                                        <form asp-action="Desmatricular" method="post"
                                              onsubmit="return confirm('¿Quitar a @i.Alumno.Nombre del curso?');">
                                            <input type="hidden" name="inscripcionId" value="@i.Id" />
                                            <input type="hidden" name="cursoId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                <i class="bi bi-person-dash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Tabla de materias *@
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h6 fw-semibold text-muted text-uppercase mb-0" style="letter-spacing:.06em;font-size:.72rem;">
                    <i class="bi bi-book me-2"></i>Materias
                </h2>
                <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@Model.CursosAsignaturas.Count</span>
            </div>
            @if (!Model.CursosAsignaturas.Any())
            {
                <div class="text-muted small fst-italic py-2">Todavía no hay materias asignadas a este curso.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold small">Materia</th>
                                <th class="fw-semibold small">Docente</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in Model.CursosAsignaturas.OrderBy(ca => ca.Asignatura.Nombre))
                            {
                                <tr>
                                    <td class="small fw-semibold">
                                        @ca.Asignatura.Nombre
                                        @if (ca.TurnoOverride != null)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill ms-1" style="font-size:.68rem;">@ca.TurnoOverride</span>
                                        }
                                    </td>
                                    <td style="min-width:240px;">
                                        <form asp-action="AsignarDocente" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="cursoAsignaturaId" value="@ca.Id" />
                                            <input type="hidden" name="cursoId" value="@Model.Id" />
                                            <select name="docenteUserId" class="form-select form-select-sm">
                                                <option value="">Sin asignar</option>
                                                @foreach (SelectListItem d in (SelectList)ViewBag.Docentes)
                                                {
                                                    <option value="@d.Value" selected="@(ca.DocenteUserId == d.Value)">@d.Text</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="QuitarAsignatura" method="post"
                                              onsubmit="return confirm('¿Quitar @ca.Asignatura.Nombre del curso?');">
                                            <input type="hidden" name="cursoAsignaturaId" value="@ca.Id" />
                                            <input type="hidden" name="cursoId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                <i class="bi bi-dash-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    @* ══ PANEL LATERAL: formularios ══ *@
    <div class="col-12 col-lg-5 d-flex flex-column gap-4">

        @* Matricular alumno *@
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h2 class="h6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing:.06em;font-size:.72rem;">
                <i class="bi bi-person-plus me-2"></i>Matricular alumno
            </h2>
            <form asp-action="Matricular" method="post">
                <input type="hidden" name="cursoId" value="@Model.Id" />
                <select name="alumnoId" class="form-select form-select-sm mb-2" required>
                    <option value="">Seleccioná un alumno...</option>
                    @foreach (var a in (List<pagos_administracion_mvc.Models.Alumno>)ViewBag.AlumnosDisponibles)
                    {
                        <option value="@a.Id">@a.Apellido, @a.Nombre — @a.Dni</option>
                    }
                </select>
                <div class="form-text mb-3 small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Solo alumnos de @Model.Nivel, @Model.GradoAnio° y turno @Model.Turno.
                </div>
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i>Agregar al curso
                </button>
            </form>
        </div>

        @* Agregar materia *@
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h2 class="h6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing:.06em;font-size:.72rem;">
                <i class="bi bi-journal-plus me-2"></i>Agregar materia
            </h2>
            @{
                var asignaturasDisponibles = (List<pagos_administracion_mvc.Models.Asignatura>)ViewBag.AsignaturasDisponibles;
            }
            @if (asignaturasDisponibles.Any())
            {
                <form asp-action="AgregarAsignatura" method="post">
                    <input type="hidden" name="cursoId" value="@Model.Id" />
                    <select name="asignaturaId" class="form-select form-select-sm mb-3" required>
                        <option value="">Seleccioná una materia...</option>
                        @foreach (var a in asignaturasDisponibles)
                        {
                            <option value="@a.Id">@a.Nombre</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-plus-lg me-1"></i>Agregar al curso
                    </button>
                </form>
            }
            else
            {
                <p class="text-muted small mb-2">No hay más materias de @Model.Nivel para agregar.</p>
            }
            <div class="mt-2">
                <a asp-controller="Asignaturas" asp-action="Create" asp-route-nivel="@Model.Nivel"
                   class="btn btn-link btn-sm px-0 small" target="_blank">
                    <i class="bi bi-plus-circle me-1"></i>Crear una materia nueva
                </a>
            </div>
        </div>

    </div>
</div>