@model pagos_administracion_mvc.Models.Curso
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Detalle del curso";
}

<h1>@Model.Etiqueta</h1>
@if (!string.IsNullOrWhiteSpace(Model.Nombre))
{
    <p class="text-muted">@Model.Nivel — @Model.GradoAnio° grado/año — Turno @Model.Turno</p>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-7">
        <h5>Alumnos inscriptos (@Model.Inscripciones.Count)</h5>
        <div class="table-responsive">
<table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Alumno</th>
                    <th>DNI</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Inscripciones.OrderBy(i => i.Alumno.Apellido))
                {
                    <tr>
                        <td class="align-middle">@i.Alumno.Apellido, @i.Alumno.Nombre</td>
                        <td class="align-middle">@i.Alumno.Dni</td>
                        <td class="align-middle text-end">
                            <form asp-action="Desmatricular" method="post" onsubmit="return confirm('¿Quitar a este alumno del curso?');">
                                <input type="hidden" name="inscripcionId" value="@i.Id" />
                                <input type="hidden" name="cursoId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Inscripciones.Any())
                {
                    <tr><td colspan="3" class="text-muted">Todavía no hay alumnos inscriptos.</td></tr>
                }
            </tbody>
        </table>
</div>
    </div>

    <div class="col-md-5">
        <h5>Matricular alumno</h5>
        <div class="card p-3">
            <form asp-action="Matricular" method="post">
                <input type="hidden" name="cursoId" value="@Model.Id" />
                <div class="form-group mb-2">
                    <select name="alumnoId" class="form-control" required>
                        <option value="">Seleccioná un alumno...</option>
                        @foreach (var a in (List<pagos_administracion_mvc.Models.Alumno>)ViewBag.AlumnosDisponibles)
                        {
                            <option value="@a.Id">@a.Apellido, @a.Nombre — DNI @a.Dni</option>
                        }
                    </select>
                    <div class="form-text">Solo se listan alumnos de @Model.Nivel, @Model.GradoAnio° y turno @Model.Turno (la misma combinación de este curso).</div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">+ Agregar al curso</button>
            </form>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-7">
        <h5>Materias (@Model.CursosAsignaturas.Count)</h5>
        <div class="table-responsive">
<table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Materia</th>
                    <th>Docente</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ca in Model.CursosAsignaturas.OrderBy(ca => ca.Asignatura.Nombre))
                {
                    <tr>
                        <td class="align-middle">
                            @ca.Asignatura.Nombre
                            @if (ca.TurnoOverride != null)
                            {
                                <span class="badge bg-secondary">Turno @ca.TurnoOverride</span>
                            }
                        </td>
                        <td class="align-middle" style="min-width: 260px;">
                            <form asp-action="AsignarDocente" method="post" class="d-flex gap-1">
                                <input type="hidden" name="cursoAsignaturaId" value="@ca.Id" />
                                <input type="hidden" name="cursoId" value="@Model.Id" />
                                <select name="docenteUserId" class="form-select form-select-sm">
                                    <option value="">Sin asignar</option>
                                    @foreach (SelectListItem d in (SelectList)ViewBag.Docentes)
                                    {
                                        <option value="@d.Value" selected="@(ca.DocenteUserId == d.Value)">@d.Text</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                            </form>
                        </td>
                        <td class="align-middle text-end">
                            <form asp-action="QuitarAsignatura" method="post" onsubmit="return confirm('¿Quitar esta materia del curso?');">
                                <input type="hidden" name="cursoAsignaturaId" value="@ca.Id" />
                                <input type="hidden" name="cursoId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.CursosAsignaturas.Any())
                {
                    <tr><td colspan="3" class="text-muted">Todavía no hay materias asignadas a este curso.</td></tr>
                }
            </tbody>
        </table>
</div>
    </div>

    <div class="col-md-5">
        <h5>Agregar materia</h5>
        <div class="card p-3">
            @{
                var asignaturasDisponibles = (List<pagos_administracion_mvc.Models.Asignatura>)ViewBag.AsignaturasDisponibles;
            }
            @if (asignaturasDisponibles.Any())
            {
                <form asp-action="AgregarAsignatura" method="post">
                    <input type="hidden" name="cursoId" value="@Model.Id" />
                    <div class="form-group mb-2">
                        <select name="asignaturaId" class="form-control" required>
                            <option value="">Seleccioná una materia...</option>
                            @foreach (var a in asignaturasDisponibles)
                            {
                                <option value="@a.Id">@a.Nombre</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">+ Agregar al curso</button>
                </form>
            }
            else
            {
                <p class="text-muted mb-2">No hay más materias de @Model.Nivel para agregar.</p>
            }
            <a asp-controller="Asignaturas" asp-action="Create" asp-route-nivel="@Model.Nivel" class="btn btn-link btn-sm px-0" target="_blank">+ Crear una materia nueva</a>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Asistencias" asp-action="Tomar" asp-route-cursoId="@Model.Id" class="btn btn-success btn-sm">
        <i class="bi bi-clipboard-check"></i> Tomar asistencia
    </a>
    <a asp-action="Index" class="btn btn-link">Volver a la lista</a>
</div>
