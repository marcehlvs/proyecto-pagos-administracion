     function toggleMuteDestacado(event) {
+        // preventDefault + stopImmediatePropagation (no solo stopPropagation):
+        // el botón está anidado dentro del contenedor con data-bs-toggle="modal",
+        // y sin cortar la propagación acá el click terminaba también abriendo el
+        // modal grande ("al tocar el botón de sonido... sale un fondo negro").
+        event.preventDefault();
+        event.stopImmediatePropagation();
         event.stopPropagation();
+
         const video = document.getElementById('videoDestacado');
         const icono = document.querySelector('#btnMuteDestacado i');
         video.muted = !video.muted;
